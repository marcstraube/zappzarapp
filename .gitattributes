# Auto detect text files
* text=auto eol=lf

# Explicitly declare files that should always have LF line endings
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.env text eol=lf
*.env.* text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf