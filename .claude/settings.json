{
  "permissions": {
    "allow": [
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__ide__getDiagnostics",

      "Bash(ENABLE_ELASTICSEARCH=true make:*)",
      "Bash(VERBOSE=1 make:*)",
      "Bash(make:*)",

      "Bash(./docker/hooks/hook-runner.sh:*)",
      "Bash(./docker/hooks/php-cs-fixer-batch.sh:*)",
      "Bash(./docker/hooks/php-hooks.sh:*)",
      "Bash(./docker/hooks/php-lint-batch.sh:*)",
      "Bash(./tests/goss/preset-runner.sh:*)",
      "Bash(./tests/goss/runtime-tests.sh:*)",
      "Bash(HOOK_RUNNER_VERBOSE=1 ./docker/hooks/hook-runner.sh:*)",
      "Bash(VERBOSE=1 ./tests/goss/preset-runner.sh:*)",

      "Bash(docker:*)",

      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(glab:*)",

      "Bash(helm:*)",
      "Bash(kubectl:*)",
      "Bash(minikube:*)",

      "Bash(dgoss:*)",
      "Bash(goss:*)",
      "Bash(shellcheck:*)",
      "Bash(vendor/bin/captainhook install:*)",

      "Bash(basename:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(dirname:*)",
      "Bash(file:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mktemp:*)",
      "Bash(mv:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(rmdir:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",

      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tee:*)",
      "Bash(tr:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",

      "Bash(curl:*)",
      "Bash(ping:*)",
      "Bash(wget:*)",

      "Bash(lsof:*)",
      "Bash(pgrep:*)",
      "Bash(ps:*)",

      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(export:*)",
      "Bash(false:*)",
      "Bash(hostname:*)",
      "Bash(id:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(sleep:*)",
      "Bash(test:*)",
      "Bash(timeout:*)",
      "Bash(true:*)",
      "Bash(type:*)",
      "Bash(uname:*)",
      "Bash(which:*)",

      "Bash(base64:*)",
      "Bash(jq:*)",
      "Bash(md5sum:*)",
      "Bash(openssl:*)",
      "Bash(sha256sum:*)",
      "Bash(yq:*)"
    ],
    "deny": [
      "Read(./secrets/**)",

      "Bash(make clean:*)",
      "Bash(make down-all:*)",
      "Bash(make fresh:*)",
      "Bash(make goss-cleanup:*)",
      "Bash(make k8s-remove:*)",
      "Bash(make node-frontend-clean:*)",
      "Bash(make prune:*)",
      "Bash(make reset:*)",
      "Bash(make secrets-rotate-passwords:*)",
      "Bash(make secrets-rotate:*)",
      "Bash(make ssl-clean:*)",

      "Bash(bats:*)",

      "Bash(composer exec:*)",
      "Bash(composer install:*)",
      "Bash(composer remove:*)",
      "Bash(composer require:*)",
      "Bash(composer update:*)",

      "Bash(npm add:*)",
      "Bash(npm exec:*)",
      "Bash(npm install:*)",
      "Bash(npm remove:*)",
      "Bash(npm update:*)",
      "Bash(npx:*)",

      "Bash(pnpm add:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/session-end.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/user-prompt-submit.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[PreCompact] Context compaction imminent! Update session file (Summary, Changes) and write pending knowledge to LEARNINGS.md, DECISIONS.md, REFERENCES.md'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "BRANCH=$(git branch --show-current 2>/dev/null); if [[ \"$BRANCH\" == \"develop\" || \"$BRANCH\" == \"main\" || \"$BRANCH\" == \"master\" ]]; then TOOL_INPUT=$(cat); FILE=$(echo \"$TOOL_INPUT\" | jq -r '.file_path // empty' 2>/dev/null); if [[ \"$FILE\" != *\"/.claude/sessions/\"* && \"$FILE\" != *\"/.claude/temp/\"* && \"$FILE\" != *\"/.claude/state/\"* ]]; then echo \"[Branch Check] ⚠️  Working on '$BRANCH' - consider feature branch (see .claude/CLAUDE.md)\"; fi; fi"
          },
          {
            "type": "command",
            "command": "BRANCH=$(git branch --show-current 2>/dev/null); if [[ \"$BRANCH\" =~ ^(feature|fix|refactor)/ ]]; then TOOL_INPUT=$(cat); FILE=$(echo \"$TOOL_INPUT\" | jq -r '.file_path // empty' 2>/dev/null); if [[ \"$FILE\" != *\"/.claude/sessions/\"* && \"$FILE\" != *\"/.claude/temp/\"* && \"$FILE\" != *\"/.claude/state/\"* ]]; then echo \"[Worktree] 💡 On branch '$BRANCH' - for parallel work use git worktree:\"; echo \"   git worktree add ../zappzarapp-wt-<name> -b <branch> develop\"; echo \"   cd ../zappzarapp-wt-<name>\"; fi; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/post-edit-lint.sh"
          },
          {
            "type": "command",
            "command": "TOOL_INPUT=$(cat); if echo \"$TOOL_INPUT\" | grep -qE '(Dockerfile|compose\\.yaml|compose\\.override|compose\\.production|\\.env\\.example|entrypoint|php\\.ini|nginx\\.conf)'; then echo '[Hook] Config file changed. Remember: make build && make down && make up'; fi"
          },
          {
            "type": "command",
            "command": "TOOL_INPUT=$(cat); if echo \"$TOOL_INPUT\" | grep -qE '\\.claude/skills/.*\\.md'; then echo '[Hook] Claude skill updated.'; fi"
          },
          {
            "type": "command",
            "command": "TOOL_INPUT=$(cat); if echo \"$TOOL_INPUT\" | grep -qE '(\\.rulesync/.*\\.md|CLAUDE\\.md)'; then echo '[Hook] AI rules updated. Sync to all tools with: make ai-rules-sync'; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "TOOL_INPUT=$(cat); if echo \"$TOOL_INPUT\" | grep -qE 'make composer CMD=\"?(require|remove)'; then echo '[Hook] PHP package changed. Run: make composer-install-local'; fi"
          },
          {
            "type": "command",
            "command": "TOOL_INPUT=$(cat); if echo \"$TOOL_INPUT\" | grep -qE 'make pnpm CMD=\"?(add|remove)'; then echo '[Hook] Node package changed. Run: make pnpm-install-local'; fi"
          }
        ]
      }
    ]
  }
}
