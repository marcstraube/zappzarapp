{
  "permissions": {
    "allow": [
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__ide__getDiagnostics",
      "Bash(ENABLE_ELASTICSEARCH=true make:*)",
      "Bash(VERBOSE=1 make:*)",
      "Bash(make:*)",
      "Bash(./docker/hooks/hook-runner.sh:*)",
      "Bash(./docker/hooks/php-hooks.sh:*)",
      "Bash(./tests/goss/preset-runner.sh:*)",
      "Bash(./tests/goss/runtime-tests.sh:*)",
      "Bash(HOOK_RUNNER_VERBOSE=1 ./docker/hooks/hook-runner.sh:*)",
      "Bash(VERBOSE=1 ./tests/goss/preset-runner.sh:*)",
      "Bash(docker:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(glab:*)",
      "Bash(helm:*)",
      "Bash(kubectl:*)",
      "Bash(minikube:*)",
      "Bash(dgoss:*)",
      "Bash(goss:*)",
      "Bash(shellcheck:*)",
      "Bash(vendor/bin/captainhook install:*)",
      "Bash(basename:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(dirname:*)",
      "Bash(du:*)",
      "Bash(file:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mktemp:*)",
      "Bash(mv:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(rmdir:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(unlink:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tee:*)",
      "Bash(tr:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(curl:*)",
      "Bash(ping:*)",
      "Bash(wget:*)",
      "Bash(lsof:*)",
      "Bash(pgrep:*)",
      "Bash(ps:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(export:*)",
      "Bash(false:*)",
      "Bash(getent:*)",
      "Bash(hostname:*)",
      "Bash(id:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(sleep:*)",
      "Bash(test:*)",
      "Bash(timeout:*)",
      "Bash(true:*)",
      "Bash(type:*)",
      "Bash(uname:*)",
      "Bash(which:*)",
      "Bash(base64:*)",
      "Bash(jq:*)",
      "Bash(md5sum:*)",
      "Bash(openssl:*)",
      "Bash(sha256sum:*)",
      "Bash(yq:*)"
    ],
    "deny": [
      "Read(./secrets/**)",
      "Bash(make clean:*)",
      "Bash(make down-all:*)",
      "Bash(make fresh:*)",
      "Bash(make goss-cleanup:*)",
      "Bash(make k8s-remove:*)",
      "Bash(make node-frontend-clean:*)",
      "Bash(make prune:*)",
      "Bash(make reset:*)",
      "Bash(make secrets-rotate-passwords:*)",
      "Bash(make secrets-rotate:*)",
      "Bash(make ssl-clean:*)",
      "Bash(bats:*)",
      "Bash(composer exec:*)",
      "Bash(composer install:*)",
      "Bash(composer remove:*)",
      "Bash(composer require:*)",
      "Bash(composer update:*)",
      "Bash(npm add:*)",
      "Bash(npm exec:*)",
      "Bash(npm install:*)",
      "Bash(npm remove:*)",
      "Bash(npm update:*)",
      "Bash(npx:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(cat | jq -r '.tool_input.file_path // empty'); if echo \"$FILE\" | grep -qE '(Dockerfile|compose\\.yaml|compose\\.override|compose\\.production|\\.env\\.example|entrypoint|php\\.ini|nginx\\.conf)'; then jq -n --arg m '[Hook] Config file changed. Remember: make build && make down && make up' '{hookSpecificOutput:{hookEventName:\"PostToolUse\",additionalContext:$m}}'; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(cat | jq -r '.tool_input.command // empty'); if echo \"$CMD\" | grep -qE 'make composer CMD=.{0,2}(require|remove)'; then jq -n --arg m '[Hook] PHP package changed. Run: make composer-install-local' '{hookSpecificOutput:{hookEventName:\"PostToolUse\",additionalContext:$m}}'; fi"
          },
          {
            "type": "command",
            "command": "CMD=$(cat | jq -r '.tool_input.command // empty'); if echo \"$CMD\" | grep -qE 'make pnpm CMD=.{0,2}(add|remove)'; then jq -n --arg m '[Hook] Node package changed. Run: make pnpm-install-local' '{hookSpecificOutput:{hookEventName:\"PostToolUse\",additionalContext:$m}}'; fi"
          }
        ]
      }
    ]
  }
}
