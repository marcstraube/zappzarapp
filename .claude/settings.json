{
  "permissions": {
    "allow": [
      "Bash(./docker/hooks/hook-runner.sh:*)",
      "Bash(./docker/hooks/php-cs-fixer-batch.sh:*)",
      "Bash(./docker/hooks/php-hooks.sh:*)",
      "Bash(./docker/hooks/php-lint-batch.sh:*)",
      "Bash(./tests/goss/preset-runner.sh:*)",
      "Bash(./tests/goss/runtime-tests.sh:*)",
      "Bash(COMPOSE_PROFILES=* docker compose:*)",
      "Bash(ENABLE_SEAWEEDFS=true docker compose:*)",
      "Bash(HOOK_RUNNER_VERBOSE=1 ./docker/hooks/hook-runner.sh:*)",
      "Bash(VERBOSE=1 ./tests/goss/preset-runner.sh:*)"
    ],
    "deny": [
      "Bash(composer install:*)",
      "Bash(composer update:*)",
      "Bash(composer require:*)",
      "Bash(composer remove:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(npm install:*)",
      "Bash(npm add:*)",
      "Bash(npm remove:*)",
      "Bash(npm update:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "TOOL_INPUT=$(cat); if echo \"$TOOL_INPUT\" | grep -qE '(Dockerfile|compose\\.yaml|compose\\.override|compose\\.production|\\.env\\.example|entrypoint|php\\.ini|nginx\\.conf)'; then echo '[Hook] Config file changed. Remember: make build && make down && make up'; fi"
          }
        ]
      }
    ]
  }
}
