# Environment
.env
.env.local
.env.*.local

# Logs
*.log
/logs/*
/storage/logs/*

# SSL Certificates (don't commit private keys!)
docker/certs/*.pem
docker/certs/*.key
docker/certs/*.crt

# Generated SSL config (from template)
docker/nginx/conf.d/ssl-production.conf

# MariaDB Encryption (don't commit keyfiles and custom configs!)
docker/mariadb/keyfile.key
docker/mariadb/my.cnf

# Build outputs
/public/build/*
dist/

# Dependencies
node_modules/
/vendor/

# Xdebug artifacts
package.xml

# OS
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo
*~

# VS Code
# Ignore user-specific files, keep workspace configuration
.vscode/*.code-workspace
.vscode/.history/

# JetBrains IDE
# Ignore user-specific workspace and tasks
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf

# Ignore caches and generated files
.idea/**/contentModel.xml
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/gradle.xml
.idea/**/libraries
.idea/**/mongoSettings.xml

# Docker
.docker/

# Storage
/storage/app/*
!/storage/app/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep

# Backups (encrypted database dumps)
/backups/

# Docker Secrets (sensitive data - never commit!)
/secrets/

# Tool Caches & Build Outputs
/build/
/.pnpm-store/
.phpunit.result.cache
.phpunit.cache
.php-cs-fixer.cache
.phpstan.cache
.rector.cache
.eslintcache

# Documentation (generated - keep index.html and assets/)
/docs/*
!/docs/index.html
!/docs/assets/
/.phpdoc/
/tools/

# Claude Code (keep commands, docs and templates, ignore runtime state)
.claude/*
!.claude/commands/
!.claude/sessions/
.claude/sessions/*
!.claude/sessions/SESSION-TEMPLATE.md
!.claude/CLAUDE.md
!.claude/LEARNINGS.md
!.claude/BACKLOG.md
!.claude/settings.json
