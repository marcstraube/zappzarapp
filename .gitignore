# Environment
.env
.env.local
.env.*.local

# Logs
*.log
/logs/*
!/logs/.gitkeep

# SSL Certificates (don't commit private keys!)
docker/nginx/certs/*.pem
docker/nginx/certs/*.key
docker/nginx/certs/*.crt

# Build outputs
/public/build/*
!/public/build/.gitkeep
/dist/

# Dependencies
/node_modules/
/vendor/

# Xdebug artifacts
package.xml

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
*.swp
*.swo
*~

# JetBrains IDE
# Ignore user-specific workspace and tasks
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf

# Ignore caches and generated files
.idea/**/contentModel.xml
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/gradle.xml
.idea/**/libraries
.idea/**/mongoSettings.xml

# Docker
.docker/

# Storage
/storage/app/*
!/storage/app/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep

# Tool Caches & Build Outputs
/build/
/.pnpm-store/
.phpunit.result.cache
.phpunit.cache
.php-cs-fixer.cache
.phpstan.cache
.rector.cache
.eslintcache

# Documentation
/docs/
/.phpdoc/
/tools/