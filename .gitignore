# Environment overrides (contain local/production secrets - never commit!)
# Base .env is committed with secure defaults
# Examples (.env.local.example, .env.production.example) are committed
.env.local
.env.production
.env.*.local

# Logs
*.log
/logs/*
/storage/logs/*

# SSL Certificates (don't commit private keys!)
docker/certs/*.pem
docker/certs/*.key
docker/certs/*.crt

# Generated SSL config (from template)
docker/nginx/conf.d/ssl-production.conf

# MariaDB Encryption (don't commit keyfiles and custom configs!)
docker/mariadb/keyfile.key
docker/mariadb/my.cnf

# Build outputs
/public/build/*
dist/

# Dependencies
node_modules/
/vendor/

# Xdebug artifacts
package.xml

# OS
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo
*~

# VS Code
# Ignore user-specific files, keep workspace configuration
.vscode/*.code-workspace
.vscode/.history/

# JetBrains IDE
# Ignore user-specific workspace and tasks
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf

# Ignore caches and generated files
.idea/**/contentModel.xml
.idea/**/dataSources.local.xml
.idea/**/sshConfigs.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/gradle.xml
.idea/**/libraries
.idea/**/mongoSettings.xml

# Docker
.docker/

# Storage
/storage/app/*
!/storage/app/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep

# Backups (encrypted database dumps)
/backups/

# Docker Secrets (sensitive data - never commit!)
# Actual secrets are ignored in secrets/.gitignore, but example files are kept
/secrets/*.txt
!/secrets/*.example.txt

# Tool Caches & Build Outputs
/build/
/.pnpm-store/
.phpunit.result.cache
.phpunit.cache
.php-cs-fixer.cache
.phpstan.cache
.rector.cache
.eslintcache

# Documentation (generated - keep index.html and assets/)
/docs/*
!/docs/index.html
!/docs/assets/
/.phpdoc/
/tools/

# Claude Code - Ignore all, selectively allow
.claude/*
!.claude/CLAUDE.md
!.claude/agents/
!.claude/commands/
!.claude/context/
!.claude/settings.json
#
# Committed in .zappzarapp/:
# - ai/ (knowledge files: LEARNINGS, DECISIONS, REFERENCES)
# - standards/ (coding standards, shared across all AI agents)
# - docs/ (boilerplate documentation)
# - CHANGELOG.md (boilerplate version history)
# - README.template.md, CLAUDE.template.md (templates for user projects)
# - README.md, CLAUDE.md (moved here by make setup)
# - ai/config.local.md.example (example for personal config)
.zappzarapp/ai/config.local.md

# Project AI knowledge (created by make setup):
# - .ai/DECISIONS.md (ADRs)
# - .ai/LEARNINGS.md (project learnings)
# - .ai/REFERENCES.md (documentation links)
# Tasks managed via /tasks command (GitHub/GitLab Issues)

# Gemini CLI - Generated from Claude via: make ai-commands-sync FROM=claude TO=gemini
# Not committed - generate with: make ai-sync
.gemini/
