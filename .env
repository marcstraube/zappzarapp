# ============================================================================
# ZAPPZARAPP - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and adjust the values for your environment.
#
# Quick Start:
#   1. make init          # Copy .env.example to .env
#   2. Edit .env:         # Adjust USER_ID, GROUP_ID to match your host user (id -u, id -g)
#   3. make setup         # Create project structure (directories, dependencies)
#   4. make up            # Build and start all services
#
# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  🔐 SECRETS MANAGEMENT (Docker Secrets)                                    ║
# ╠════════════════════════════════════════════════════════════════════════════╣
# ║  This project uses Docker Secrets for sensitive data:                      ║
# ║  • DB_PASSWORD, DB_ROOT_PASSWORD, ENCRYPTION_KEY, BACKUP_KEY               ║
# ║  • Secrets are stored in ./secrets/ (auto-generated by 'make setup')       ║
# ║  • Mounted to containers at /run/secrets/<secret_name>                     ║
# ║  • Never commit ./secrets/ to version control (.gitignore)                 ║
# ║                                                                            ║
# ║  FOR PRODUCTION:                                                           ║
# ║  • Use external secrets (Kubernetes, HashiCorp Vault, etc.)                ║
# ║  • See: documentation/security/SECRETS.md                                  ║
# ╚════════════════════════════════════════════════════════════════════════════╝
# ============================================================================

# ----------------------------------------------------------------------------
# PROJECT IDENTIFICATION
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=zappzarapp

# Project Domain (used by SSL, email, API URLs, etc.)
# Set your domain here (e.g., example.com)
# Will be prompted if not set when running SSL commands
#DOMAIN=

# ----------------------------------------------------------------------------
# ENVIRONMENT MODE
# ----------------------------------------------------------------------------
# Environment: development or production
# - development: Dev dependencies, verbose logging, debug tools
# - production: Production dependencies only, optimized, minimal logging
ENV=development

# ----------------------------------------------------------------------------
# SERVICE ACTIVATION - Granular Control
# ----------------------------------------------------------------------------
# Enable/disable individual services for your stack.
# Set to 'true' or 'false' to control which services start with 'make up'.
#
# Available Services:
# - Nginx: Always enabled (entry point, reverse proxy - required)
# - PHP: PHP-FPM for backend applications
# - Node: Node.js for frontend (Vite) and/or backend (Express)
# - Database: PostgreSQL or MariaDB (type controlled via DB_TYPE)
# - Redis: Cache, sessions, job queues
#
# ─────────────────────────────────────────────────────────────────────────
# PRESETS - Uncomment the preset you want to use:
# ─────────────────────────────────────────────────────────────────────────
#
# [1] Full-Stack (PHP + Node.js + Database + Redis) - DEFAULT
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true
#
# [2] Pure PHP Stack (PHP + Database + Redis, no Node.js)
#   ENABLE_PHP=true
#   ENABLE_NODE=false
#   ENABLE_DATABASE=true
#   ENABLE_REDIS=true
#
# [3] Pure Node.js Stack (Node.js + Database + Redis, no PHP)
#   ENABLE_PHP=false
#   ENABLE_NODE=true
#   ENABLE_DATABASE=true
#   ENABLE_REDIS=true
#
# [4] Static/JAMstack (Nginx only, pre-built assets)
#   ENABLE_PHP=false
#   ENABLE_NODE=false
#   ENABLE_DATABASE=false
#   ENABLE_REDIS=false
#
# [5] Minimal Node.js (Node.js only, no Database/Redis)
#   ENABLE_PHP=false
#   ENABLE_NODE=true
#   ENABLE_DATABASE=false
#   ENABLE_REDIS=false
#
# [6] Minimal PHP (PHP only, no Database/Redis)
#   ENABLE_PHP=true
#   ENABLE_NODE=false
#   ENABLE_DATABASE=false
#   ENABLE_REDIS=false
#
# [7] Custom: Mix and match services as needed
#
# ─────────────────────────────────────────────────────────────────────────
# OPTIONAL SERVICES (disabled by default)
# ─────────────────────────────────────────────────────────────────────────
# Mercure: Real-time messaging (SSE)
ENABLE_MERCURE=false
# Meilisearch: Lightweight search engine
ENABLE_MEILISEARCH=false
# Elasticsearch: Full-featured search (resource-intensive, min 2GB RAM)
ENABLE_ELASTICSEARCH=false
# Mailpit: Email testing (catches all outgoing emails)
ENABLE_MAILPIT=false
# SeaweedFS: S3-compatible object storage
ENABLE_SEAWEEDFS=false
# RabbitMQ: Enterprise message broker
ENABLE_RABBITMQ=false

# ----------------------------------------------------------------------------
# NODE.JS CONFIGURATION (only relevant if ENABLE_NODE=true)
# ----------------------------------------------------------------------------
# NODE_MODE: Controls which Node.js services run
#
# ┌─────────────────┬────────────────────────────────────────────────────────┐
# │ Mode            │ Description                                            │
# ├─────────────────┼────────────────────────────────────────────────────────┤
# │ assets-api      │ Vite frontend + Express API (default full-stack)       │
# │ assets          │ Vite frontend only (no backend API)                    │
# │ api             │ Express API only (no frontend build)                   │
# │ framework       │ Node framework only (Nuxt, Next.js, Remix, SvelteKit)  │
# │ framework-api   │ Node framework + Express API                           │
# │ idle            │ Container sleeps (for manual pnpm commands)            │
# └─────────────────┴────────────────────────────────────────────────────────┘
#
# Development: Vite HMR on port 5173, Express on :3000, Framework on :3001
# Production:  Makefile auto-selects correct Docker build targets
#
NODE_MODE=assets-api

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
# Connection URL (used in production/PaaS)
# Format: driver://user:password@host:port/database
# If set, this takes precedence over individual variables below.
# PaaS providers (Heroku, Railway, Render) set this automatically.
#DATABASE_URL=postgresql://app:secret@postgres:5432/app

# Individual variables (Development fallback)
# Used when DATABASE_URL is not set. More readable, no URL-encoding needed.
# Code can also access these directly for specific values.
#
# DB_TYPE: Database type - determines DSN driver (pgsql/mysql) and which
#          container starts when ENABLE_DATABASE=true.
#          Values: postgres, mariadb
#
# DB_HOST: Connection target (hostname/IP of database server)
#          - Internal DB: Use container name (postgres or mariadb)
#          - External DB: Use hostname/IP (e.g., db.example.com, 10.0.0.5)
#
# Example configurations:
#   Internal PostgreSQL:  ENABLE_DATABASE=true   DB_TYPE=postgres  DB_HOST=postgres
#   Internal MariaDB:     ENABLE_DATABASE=true   DB_TYPE=mariadb   DB_HOST=mariadb
#   External PostgreSQL:  ENABLE_DATABASE=false  DB_TYPE=postgres  DB_HOST=db.example.com
#   External MariaDB:     ENABLE_DATABASE=false  DB_TYPE=mariadb   DB_HOST=db.example.com
#
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app
# ─────────────────────────────────────────────────────────────────────────
# DATABASE PASSWORDS
# ─────────────────────────────────────────────────────────────────────────
# Default: Docker Secrets (recommended)
#   Passwords are stored in ./secrets/ and auto-generated by 'make setup'.
#   No configuration needed here - compose.yaml uses POSTGRES_PASSWORD_FILE.
#
# Alternative: Environment Variables (for external DB or legacy setups)
#   1. Edit compose.yaml: Comment out *_PASSWORD_FILE, uncomment *_PASSWORD
#   2. Set passwords below:
#DB_PASSWORD=your_secure_password
#DB_ROOT_PASSWORD=your_root_password
#
# See: documentation/security/SECRETS.md for details
# ─────────────────────────────────────────────────────────────────────────

# SSL/TLS Configuration (Required for MariaDB, optional for PostgreSQL)
# PostgreSQL auto-negotiates SSL; MariaDB requires explicit configuration.
#
# DB_SSL_CA: CA certificate for SSL connections
# - (empty):  Auto-detect internal cert for MariaDB, none for PostgreSQL
# - system:   Use system CA bundle (for cloud DBs with public CA-signed certs)
#             Works with: AWS RDS, Google Cloud SQL, Azure, PlanetScale, Neon, etc.
# - /path:    Custom cert path (place in ./docker/certs/, use /etc/ssl/db-certs/...)
#DB_SSL_CA=
#
# DB_SSL_VERIFY: Verify server certificate (true/false)
# - true:  Verify certificate chain (recommended for production/external DBs)
# - false: Skip verification (default, for self-signed internal certs)
#DB_SSL_VERIFY=false

# ─────────────────────────────────────────────────────────────────────────
# REMOTE DATABASE ACCESS (IDE only)
# ─────────────────────────────────────────────────────────────────────────
# These settings enable PHPStorm to connect to remote databases (e.g., production)
# via SSH tunnel. Used by 'make ide-config' to generate dataSources.local.xml.
#
# Team-shared settings go here or in .env.production (no secrets!)
# Personal SSH credentials go in .env.local (gitignored)
#
# Remote DB connection (the actual database behind SSH):
#DB_REMOTE_HOST=internal-db.k8s.cluster
#DB_REMOTE_PORT=5432
#DB_REMOTE_NAME=production
#DB_REMOTE_USER=app_readonly
#
# SSH tunnel settings (personal - configure in .env.local):
#DB_REMOTE_SSH_HOST=bastion.example.com
#DB_REMOTE_SSH_PORT=22
#DB_REMOTE_SSH_USER=your-username
#DB_REMOTE_SSH_KEY=~/.ssh/id_ed25519
# ─────────────────────────────────────────────────────────────────────────

# Redis Connection URL
# Uses TLS (rediss://) for encrypted connections in both development and production
# Note: Self-signed certificates are auto-generated by 'make setup'
REDIS_URL=rediss://redis:6379

# ----------------------------------------------------------------------------
# PORT BINDING - External Access
# ----------------------------------------------------------------------------
# Nginx (Web Server - Entry Point)
NGINX_PORT=8080

# Nginx SSL/HTTPS Port
NGINX_SSL_PORT=8443

# ─────────────────────────────────────────────────────────────────────────
# NODE.JS PORT ASSIGNMENT (Internal, accessed via Nginx only)
# ─────────────────────────────────────────────────────────────────────────
# Node.js services are NOT directly exposed (security by design).
# Access is via Nginx reverse proxy with TLS termination:
#
#   https://localhost:8443/api/node/*  → node:3000 (Express Backend)
#   https://localhost:8443/app/*       → node:3001 (Nuxt Frontend)
#
# Only Vite HMR is directly exposed for development hot-reload.
# See: documentation/infrastructure/NETWORK.md
# ─────────────────────────────────────────────────────────────────────────

# Vite Dev Server (HMR WebSocket - Development only, direct access required)
VITE_PORT=5173

# Redis (Cache/Sessions - requires ENABLE_REDIS=true)
REDIS_PORT=6379

# PostgreSQL Database (requires DB_TYPE=postgres)
POSTGRES_PORT=5432

# MariaDB Database (requires DB_TYPE=mariadb)
MARIADB_PORT=3306

# Mercure Hub (requires ENABLE_MERCURE=true)
MERCURE_PORT=8081

# Meilisearch (requires ENABLE_MEILISEARCH=true)
MEILISEARCH_PORT=7700

# Elasticsearch (requires ENABLE_ELASTICSEARCH=true)
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300

# Mailpit (requires ENABLE_MAILPIT=true)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# SeaweedFS (requires ENABLE_SEAWEEDFS=true)
SEAWEEDFS_S3_PORT=8333

# RabbitMQ (requires ENABLE_RABBITMQ=true)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ----------------------------------------------------------------------------
# STORAGE & DATA PATHS
# ----------------------------------------------------------------------------
# Storage Directory (Runtime data: uploads, cache, sessions)
# Development: Use relative paths (./storage)
# Production: Use absolute paths for NFS/shared storage
#   Example: STORAGE_DIR=/mnt/nfs/storage
STORAGE_DIR=./storage

# ----------------------------------------------------------------------------
# SYSTEM CONFIGURATION
# ----------------------------------------------------------------------------
# User and Group IDs for File Permissions
# IMPORTANT: Set these to match your host user to avoid permission issues
# Run these commands to get your IDs:
#   id -u    # Your User ID
#   id -g    # Your Group ID
USER_ID=1000
GROUP_ID=1000

# Timezone for all containers (logs, timestamps, scheduled tasks)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Berlin

# ----------------------------------------------------------------------------
# DEVELOPMENT TOOLS
# ----------------------------------------------------------------------------
# Xdebug (PHP - Development only, has no effect in production)
# Modes:
# - off:            Disabled (default, better performance)
# - debug:          Enable step debugging
# - develop,debug:  Enable debugging + var_dump enhancements
XDEBUG_MODE=off

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
# Log Level (debug, info, warning, error)
LOG_LEVEL=info

# Log Format
# - json:   Structured logging for production (machine-readable)
# - pretty: Human-readable format for development
LOG_FORMAT=json

# ----------------------------------------------------------------------------
# CORS CONFIGURATION (Node.js Backend)
# ----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated list)
# - '*': Allow all origins (development only!)
# - 'https://example.com,https://app.example.com': Specific origins (production)
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# MERCURE CONFIGURATION (Real-time messaging)
# ----------------------------------------------------------------------------
# JWT secret is managed via Docker Secrets (auto-generated by 'make setup')
# For external Mercure instances, set the host:
#MERCURE_HOST=mercure
#MERCURE_URL=http://mercure:80/.well-known/mercure

# ----------------------------------------------------------------------------
# MEILISEARCH CONFIGURATION (Search engine)
# ----------------------------------------------------------------------------
# Master key is managed via Docker Secrets (auto-generated by 'make setup')
# For external Meilisearch instances, set the host:
#MEILISEARCH_HOST=meilisearch
#MEILISEARCH_URL=http://meilisearch:7700

# ----------------------------------------------------------------------------
# ELASTICSEARCH CONFIGURATION (Search & Analytics)
# ----------------------------------------------------------------------------
# JVM Heap size (should be ~50% of container memory limit)
# Minimum recommended: 512m, Production: 1g-2g
ELASTICSEARCH_HEAP_SIZE=512m

# For external Elasticsearch instances:
#ELASTICSEARCH_HOST=elasticsearch
#ELASTICSEARCH_URL=http://elasticsearch:9200

# ----------------------------------------------------------------------------
# MAILPIT CONFIGURATION (Email testing)
# ----------------------------------------------------------------------------
# Maximum number of emails to store (older ones are deleted)
MAILPIT_MAX_MESSAGES=500

# SMTP settings for your application (use these in your app config):
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_ENCRYPTION=null

# ----------------------------------------------------------------------------
# SEAWEEDFS CONFIGURATION (S3-compatible storage)
# ----------------------------------------------------------------------------
# Credentials are managed via Docker Secrets (auto-generated by 'make setup')
# For external S3 instances, set these:
#S3_ENDPOINT=https://seaweedfs:8333
#S3_ACCESS_KEY=your-access-key
#S3_SECRET_KEY=your-secret-key
#S3_BUCKET=uploads
#S3_REGION=us-east-1

# ----------------------------------------------------------------------------
# RABBITMQ CONFIGURATION (Message broker)
# ----------------------------------------------------------------------------
# Credentials are managed via Docker Secrets (auto-generated by 'make setup')
# Virtual host (default: /)
RABBITMQ_VHOST=/

# For external RabbitMQ instances:
#RABBITMQ_HOST=rabbitmq
#RABBITMQ_URL=amqp://user:password@rabbitmq:5672/
#RABBITMQ_URL=amqps://user:password@rabbitmq:5671/  # TLS

# ----------------------------------------------------------------------------
# ENCRYPTION & SECURITY
# ----------------------------------------------------------------------------
# Encryption keys are managed via Docker Secrets:
# - ./secrets/encryption_key.txt (auto-generated by 'make setup')
# - ./secrets/backup_encryption_key.txt (auto-generated by 'make setup')
# These are mounted to containers at /run/secrets/encryption_key and
# /run/secrets/backup_encryption_key respectively.
#
# For legacy/external systems, you can still use environment variables:
#ENCRYPTION_KEY=
#BACKUP_ENCRYPTION_KEY=

# Backup retention policy (days) - backups older than this are auto-deleted
# Set to 0 to keep all backups (no auto-deletion)
BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# RENOVATE AUTO-UPDATE CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
# Used by 'make renovate' for automated dependency scanning.
# Set a Personal Access Token (PAT) for your Git host to enable Pull Requests.
# RENOVATE_PLATFORM can be 'github', 'gitlab', 'bitbucket', or empty for local mode.
#
# Examples:
#   GITHUB_COM_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   GITLAB_COM_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
#
# Repository slug for platform mode (e.g., 'your-org/project-name'):
#   RENOVATE_REPO_SLUG=

# ----------------------------------------------------------------------------
# AI TOOL SYNCHRONIZATION
# ----------------------------------------------------------------------------
# Configuration for 'make ai-commands-sync' (Claude <-> Gemini command sync).
# This project uses Claude Code as the source of truth for AI commands.
#
# AI_SYNC_FROM: Source tool for command sync (default: claude)
# AI_SYNC_TO: Target tool(s) - leave empty to sync to all supported tools
#             Supports multiple values: comma or space separated (e.g., "gemini,cursor")
#
# Supported tools for commands: claude, gemini
# Supported tools for rules: claude, gemini, cursor, copilot, cline, roo
AI_SYNC_FROM=claude
#AI_SYNC_TO=
