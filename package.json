{
  "name": "zappzarapp",
  "version": "1.0.0",
  "description": "A professional web development stack that gets you coding in minutes - zappzarapp!",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcstraube/zappzarapp.git"
  },
  "bugs": {
    "url": "https://github.com/marcstraube/zappzarapp/issues"
  },
  "homepage": "https://github.com/marcstraube/zappzarapp#readme",
  "author": {
    "name": "Marc Straube",
    "email": "email@marcstraube.de",
    "url": "https://github.com/marcstraube"
  },
  "scripts": {
    "dev": "vite",
    "dev:vite": "pm2-runtime start ecosystem.config.cjs --only vite",
    "dev:backend": "pm2-runtime start ecosystem.config.cjs --only backend",
    "dev:full": "pm2-runtime start ecosystem.config.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc -p tsconfig.resources.json",
    "backend:dev": "pnpm --filter @zappzarapp/backend dev",
    "backend:build": "pnpm --filter @zappzarapp/backend build",
    "backend:start": "pnpm --filter @zappzarapp/backend start",
    "frontend:dev": "pnpm --filter @zappzarapp/frontend dev",
    "frontend:build": "pnpm --filter @zappzarapp/frontend build",
    "frontend:start": "pnpm --filter @zappzarapp/frontend start",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "lint": "eslint 'src/**/*.{ts,js}' 'tests/**/*.{ts,js}' 'resources/js/**/*.ts' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.{ts,js}' 'tests/**/*.{ts,js}' 'resources/js/**/*.ts' --fix",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules'",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md' '#node_modules'",
    "format": "prettier --write 'src/**/*.{ts,js,json}' '!node_modules/**'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}' '!node_modules/**'",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "docs": "pnpm run docs:backend && pnpm run docs:frontend",
    "docs:backend": "typedoc --options typedoc.backend.json",
    "docs:frontend": "typedoc --options typedoc.frontend.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "depcheck": "^1.4.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.30.0",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.1",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.3",
    "postcss": "^8.5.23",
    "prettier": "3.9.6",
    "prettier-plugin-toml": "^2.0.6",
    "sass": "^1.101.7",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@zappzarapp/audit-logger": "^1.0.0",
    "@zappzarapp/browser-utils": "^2.1.0",
    "amqplib": "^2.0.1",
    "meilisearch": "^0.60.0",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.0",
    "pg": "^8.16.3",
    "redis": "^6.1.0"
  }
}
