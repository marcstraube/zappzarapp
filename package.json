{
  "name": "docker-webdev",
  "version": "1.0.0",
  "description": "Flexible Docker boilerplate for PHP and Node.js development",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:frontend": "pm2-runtime start ecosystem.config.cjs --only vite",
    "dev:backend": "pm2-runtime start ecosystem.config.cjs --only backend",
    "dev:full": "pm2-runtime start ecosystem.config.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "server:build": "tsc --project tsconfig.json",
    "server:dev": "tsx watch src/node/server.ts",
    "server:start": "node dist/server.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "autoprefixer": "^10.4.23",
    "pino-pretty": "^13.1.3",
    "pm2": "^5.4.3",
    "postcss": "^8.5.6",
    "sass": "^1.97.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.6"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.1"
}
