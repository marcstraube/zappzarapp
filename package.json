{
  "name": "zappzarapp",
  "version": "1.0.0",
  "description": "A professional web development stack that gets you coding in minutes - zappzarapp!",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcstraube/zappzarapp.git"
  },
  "bugs": {
    "url": "https://github.com/marcstraube/zappzarapp/issues"
  },
  "homepage": "https://github.com/marcstraube/zappzarapp#readme",
  "author": {
    "name": "Marc Straube",
    "email": "email@marcstraube.de",
    "url": "https://github.com/marcstraube"
  },
  "scripts": {
    "dev": "vite",
    "dev:vite": "pm2-runtime start ecosystem.config.cjs --only vite",
    "dev:backend": "pm2-runtime start ecosystem.config.cjs --only backend",
    "dev:full": "pm2-runtime start ecosystem.config.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "backend:dev": "pnpm --filter @zappzarapp/backend dev",
    "backend:build": "pnpm --filter @zappzarapp/backend build",
    "backend:start": "pnpm --filter @zappzarapp/backend start",
    "frontend:dev": "pnpm --filter @zappzarapp/frontend dev",
    "frontend:build": "pnpm --filter @zappzarapp/frontend build",
    "frontend:start": "pnpm --filter @zappzarapp/frontend start",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.{ts,js}' 'tests/**/*.{ts,js}' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.{ts,js}' 'tests/**/*.{ts,js}' --fix",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules'",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md' '#node_modules'",
    "format": "prettier --write 'src/**/*.{ts,js,json}' '**/*.md' '**/*.toml' '!node_modules/**'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}' '**/*.md' '**/*.toml' '!node_modules/**'",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "docs": "pnpm run docs:backend && pnpm run docs:frontend",
    "docs:backend": "typedoc --options typedoc.backend.json",
    "docs:frontend": "typedoc --options typedoc.frontend.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.2.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.9",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "ai-command-converter": "^0.1.0",
    "autoprefixer": "^10.4.23",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "knip": "^5.82.1",
    "lint-staged": "^16.2.7",
    "markdownlint-cli2": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "pm2": "^6.0.14",
    "postcss": "^8.5.6",
    "prettier": "^3.8.0",
    "prettier-plugin-toml": "^2.0.6",
    "rulesync": "^5.7.0",
    "sass": "^1.97.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "amqplib": "^0.10.9",
    "mysql2": "^3.16.1",
    "redis": "^5.10.0"
  }
}
