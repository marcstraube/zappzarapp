{
  "name": "docker-webdev",
  "version": "1.0.0",
  "description": "Flexible Docker boilerplate for PHP and Node.js development",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:frontend": "pm2-runtime start ecosystem.config.cjs --only vite",
    "dev:backend": "pm2-runtime start ecosystem.config.cjs --only backend",
    "dev:full": "pm2-runtime start ecosystem.config.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "server:build": "tsc --project tsconfig.json",
    "server:dev": "tsx watch src/node/server.ts",
    "server:start": "node dist/server.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.{ts,js}' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.{ts,js}' --fix",
    "format": "prettier --write 'src/**/*.{ts,js,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json,md}'",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run test",
    "docs": "typedoc"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.18.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.2",
    "pino-pretty": "^13.1.3",
    "pm2": "^6.0.14",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "sass": "^1.97.1",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.15",
    "typescript": "^5.9.3",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.26.2"
}
