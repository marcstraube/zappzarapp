# ============================================================================
# DOCKER WEBDEV BOILERPLATE - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and adjust the values for your environment.
# This configuration follows 12-Factor App principles for maximum portability.
#
# Quick Start:
#   1. make init          # Copy .env.example to .env
#   2. Edit .env:         # Adjust USER_ID, GROUP_ID to match your host user (id -u, id -g)
#   3. make setup         # Create project structure (directories, dependencies)
#   4. make up            # Build and start all services
# ============================================================================

# ----------------------------------------------------------------------------
# PROJECT IDENTIFICATION
# ----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=docker-webdev

# Project Domain (used by SSL, email, API URLs, etc.)
# Set your domain here (e.g., example.com)
# Will be prompted if not set when running SSL commands
#DOMAIN=

# ----------------------------------------------------------------------------
# ENVIRONMENT MODE
# ----------------------------------------------------------------------------
# Environment: development or production
# - development: Dev dependencies, verbose logging, debug tools
# - production: Production dependencies only, optimized, minimal logging
ENV=development

# ----------------------------------------------------------------------------
# SERVICE ACTIVATION - Granular Control
# ----------------------------------------------------------------------------
# Enable/disable individual services for your stack.
# Set to 'true' or 'false' to control which services start with 'make up'.
#
# Available Services:
# - Nginx: Always enabled (entry point, reverse proxy - required)
# - PHP: PHP-FPM for backend applications
# - Node: Node.js for frontend (Vite) and/or backend (Express)
# - Database: PostgreSQL or MariaDB (type controlled via DB_TYPE)
# - Redis: Cache, sessions, job queues
#
# ─────────────────────────────────────────────────────────────────────────
# PRESETS - Uncomment the preset you want to use:
# ─────────────────────────────────────────────────────────────────────────
#
# [1] Full-Stack (PHP + Node.js + Database + Redis) - DEFAULT
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true
#
# [2] Pure PHP Stack (PHP + Database + Redis, no Node.js)
#   ENABLE_PHP=true
#   ENABLE_NODE=false
#   ENABLE_DATABASE=true
#   ENABLE_REDIS=true
#
# [3] Pure Node.js Stack (Node.js + Database + Redis, no PHP)
#   ENABLE_PHP=false
#   ENABLE_NODE=true
#   ENABLE_DATABASE=true
#   ENABLE_REDIS=true
#
# [4] Static/JAMstack (Nginx only, pre-built assets)
#   ENABLE_PHP=false
#   ENABLE_NODE=false
#   ENABLE_DATABASE=false
#   ENABLE_REDIS=false
#
# [5] Minimal Node.js (Node.js only, no Database/Redis)
#   ENABLE_PHP=false
#   ENABLE_NODE=true
#   ENABLE_DATABASE=false
#   ENABLE_REDIS=false
#
# [6] Minimal PHP (PHP only, no Database/Redis)
#   ENABLE_PHP=true
#   ENABLE_NODE=false
#   ENABLE_DATABASE=false
#   ENABLE_REDIS=false
#
# [7] Custom: Mix and match services as needed

# ----------------------------------------------------------------------------
# NODE.JS CONFIGURATION (only relevant if ENABLE_NODE=true)
# ----------------------------------------------------------------------------
# NODE_MODE: Controls which Node.js services run inside the container
# - full-stack:    Vite (Frontend HMR) + Express (Backend API) via PM2
# - vite-only:     Only Vite dev server (Frontend Development)
# - backend-only:  Only Express API server (Backend)
# - none:          Container runs idle (for manual npm/pnpm commands)
NODE_MODE=full-stack

# NODE_TARGET: Docker build target (Advanced - usually auto-selected)
# - development:  Development container with mounted volumes
# - asset-server: Production assets only (static files)
# - app-server:   Production Node.js backend server
#NODE_TARGET=development

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION (12-Factor App: Backing Services)
# ----------------------------------------------------------------------------
# Connection URL (12-Factor compliant - used in production/PaaS)
# Format: driver://user:password@host:port/database
# If set, this takes precedence over individual variables below.
# PaaS providers (Heroku, Railway, Render) set this automatically.
#DATABASE_URL=postgresql://app:secret@postgres:5432/app

# Individual variables (Development fallback)
# Used when DATABASE_URL is not set. More readable, no URL-encoding needed.
# Code can also access these directly for specific values.
#
# DB_TYPE: Database type - determines DSN driver (pgsql/mysql) and which
#          container starts when ENABLE_DATABASE=true.
#          Values: postgres, mariadb
#
# DB_HOST: Connection target (hostname/IP of database server)
#          - Internal DB: Use container name (postgres or mariadb)
#          - External DB: Use hostname/IP (e.g., db.example.com, 10.0.0.5)
#
# Example configurations:
#   Internal PostgreSQL:  ENABLE_DATABASE=true   DB_TYPE=postgres  DB_HOST=postgres
#   Internal MariaDB:     ENABLE_DATABASE=true   DB_TYPE=mariadb   DB_HOST=mariadb
#   External PostgreSQL:  ENABLE_DATABASE=false  DB_TYPE=postgres  DB_HOST=db.example.com
#   External MariaDB:     ENABLE_DATABASE=false  DB_TYPE=mariadb   DB_HOST=db.example.com
#
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=secret

# Root Password (MariaDB only - not used by PostgreSQL)
DB_ROOT_PASSWORD=rootsecret

# SSL/TLS Configuration (Required for MariaDB, optional for PostgreSQL)
# PostgreSQL auto-negotiates SSL; MariaDB requires explicit configuration.
#
# DB_SSL_CA: CA certificate for SSL connections
# - (empty):  Auto-detect internal cert for MariaDB, none for PostgreSQL
# - system:   Use system CA bundle (for cloud DBs with public CA-signed certs)
#             Works with: AWS RDS, Google Cloud SQL, Azure, PlanetScale, Neon, etc.
# - /path:    Custom cert path (place in ./docker/certs/, use /etc/ssl/db-certs/...)
#DB_SSL_CA=
#
# DB_SSL_VERIFY: Verify server certificate (true/false)
# - true:  Verify certificate chain (recommended for production/external DBs)
# - false: Skip verification (default, for self-signed internal certs)
#DB_SSL_VERIFY=false

# Redis Connection URL (12-Factor compliant)
REDIS_URL=redis://redis:6379

# ----------------------------------------------------------------------------
# PORT BINDING - External Access
# ----------------------------------------------------------------------------
# Nginx (Web Server - Entry Point)
NGINX_PORT=8080

# Nginx SSL/HTTPS Port
NGINX_SSL_PORT=8443

# Vite Dev Server (Frontend HMR - Development only, requires ENABLE_NODE=true)
VITE_PORT=5173

# Node.js Backend Server (API - requires ENABLE_NODE=true)
NODE_PORT=3000

# Redis (Cache/Sessions - requires ENABLE_REDIS=true)
REDIS_PORT=6379

# PostgreSQL Database (requires DB_TYPE=postgres)
POSTGRES_PORT=5432

# MariaDB Database (requires DB_TYPE=mariadb)
MARIADB_PORT=3306

# ----------------------------------------------------------------------------
# STORAGE & DATA PATHS
# ----------------------------------------------------------------------------
# Storage Directory (Runtime data: uploads, cache, sessions)
# Development: Use relative paths (./storage)
# Production: Use absolute paths for NFS/shared storage
#   Example: STORAGE_DIR=/mnt/nfs/storage
STORAGE_DIR=./storage

# ----------------------------------------------------------------------------
# SYSTEM CONFIGURATION
# ----------------------------------------------------------------------------
# User and Group IDs for File Permissions
# IMPORTANT: Set these to match your host user to avoid permission issues
# Run these commands to get your IDs:
#   id -u    # Your User ID
#   id -g    # Your Group ID
USER_ID=1000
GROUP_ID=1000

# Timezone for all containers (logs, timestamps, scheduled tasks)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Berlin

# ----------------------------------------------------------------------------
# DEVELOPMENT TOOLS
# ----------------------------------------------------------------------------
# Xdebug (PHP - Development only, has no effect in production)
# Modes:
# - off:            Disabled (default, better performance)
# - debug:          Enable step debugging
# - develop,debug:  Enable debugging + var_dump enhancements
XDEBUG_MODE=off

# ----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ----------------------------------------------------------------------------
# Log Level (debug, info, warning, error)
LOG_LEVEL=info

# Log Format
# - json:   Structured logging for production (machine-readable)
# - pretty: Human-readable format for development
LOG_FORMAT=json

# ----------------------------------------------------------------------------
# CORS CONFIGURATION (Node.js Backend)
# ----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated list)
# - '*': Allow all origins (development only!)
# - 'https://example.com,https://app.example.com': Specific origins (production)
CORS_ORIGINS=*

# ----------------------------------------------------------------------------
# ENCRYPTION & SECURITY
# ----------------------------------------------------------------------------
# Encryption keys for sensitive data (AES-256, auto-generated by 'make setup')
# Leave empty - will be generated automatically if not present
# WARNING: Keep these secret! Never commit to version control
#ENCRYPTION_KEY=
#BACKUP_ENCRYPTION_KEY=

# Backup retention policy (days) - backups older than this are auto-deleted
# Set to 0 to keep all backups (no auto-deletion)
BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# RENOVATE AUTO-UPDATE CONFIGURATION (Optional)
# ----------------------------------------------------------------------------
# Used by 'make renovate' for automated dependency scanning.
# Set a Personal Access Token (PAT) for your Git host to enable Pull Requests.
# RENOVATE_PLATFORM can be 'github', 'gitlab', 'bitbucket', or empty for local mode.
#
# Examples:
#   GITHUB_COM_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   GITLAB_COM_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
#
# Repository slug for platform mode (e.g., 'your-org/project-name'):
#   RENOVATE_REPO_SLUG=

# ============================================================================
# 12-FACTOR APP COMPLIANCE CHECKLIST
# ============================================================================
# This configuration follows all 12 factors:
#
#  ✅  I.   Codebase        - One codebase tracked in Git
#  ✅  II.  Dependencies    - Explicitly declared (composer.json, package.json)
#  ✅  III. Config          - Stored in environment (.env)
#  ✅  IV.  Backing Services - Attached resources (PostgreSQL, Redis)
#  ✅  V.   Build/Release/Run - Separate stages (Dockerfile multi-stage)
#  ✅  VI.  Processes       - Stateless (sessions in Redis, uploads in storage)
#  ✅  VII. Port Binding    - Self-contained (each service binds its port)
#  ✅  VIII. Concurrency    - Scale via process model (Docker Compose, PM2)
#  ✅  IX.  Disposability   - Fast startup, graceful shutdown (health checks)
#  ✅  X.   Dev/Prod Parity - Same stack in development and production
#  ✅  XI.  Logs            - Treat logs as event streams (stdout/stderr, JSON)
#  ✅  XII. Admin Processes - Run in same environment (make commands)
# ============================================================================
