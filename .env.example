# Environment Configuration
# Copy this file to .env and adjust the values

# Project
COMPOSE_PROJECT_NAME=docker-webdev

# Environment: development or production
# - development: Installs dev dependencies, more verbose logging
# - production: Production dependencies only, optimized autoloader
ENV=production

# Nginx Port
# The port on which Nginx will be accessible on the host
NGINX_PORT=8080

# Storage Paths
# Development: Use relative paths (./storage)
# Production: Use absolute paths for NFS/shared storage
#   Example: STORAGE_DIR=/mnt/external/storage
STORAGE_DIR=./storage

# User and Group IDs
# IMPORTANT: Set these to match your host user to avoid permission issues
# Run these commands to get your IDs:
#   id -u    # Your User ID
#   id -g    # Your Group ID
# Then uncomment and set the values below:
#USER_ID=1000
#GROUP_ID=1000

# Xdebug (Development only - has no effect in production)
# off = Disabled (default, better performance)
# debug = Enable step debugging
# develop,debug = Enable debugging + var_dump enhancements
XDEBUG_MODE=off

# -----------------------------------------------------------
# RENOVATE AUTO-UPDATE CONFIGURATION
# -----------------------------------------------------------
# Used by 'make renovate' for dependency scanning.
# Set a Personal Access Token (PAT) for your Git host to enable Pull Request creation.
# RENOVATE_PLATFORM can be 'github', 'gitlab', 'bitbucket', or empty for local filesystem mode.
# If empty, 'make renovate' will run in local filesystem mode (no PRs created).
#
# Examples:
# GITHUB_COM_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITLAB_COM_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
#
# Set the repository slug (e.g., 'your-org/project-name') for platform mode.
# RENOVATE_REPO_SLUG=