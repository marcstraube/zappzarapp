# Environment Configuration
# Copy this file to .env and adjust the values

# Environment: development or production
# - development: Installs dev dependencies, more verbose logging
# - production: Production dependencies only, optimized autoloader
ENV=production

# Nginx Port
# The port on which Nginx will be accessible on the host
NGINX_PORT=8080

# Storage Paths
# Development: Use relative paths (./data, ./logs)
# Production: Use absolute paths for NFS/shared storage
#   Example: DATA_DIR=/mnt/storage/data
#            LOG_DIR=/var/log/docker-app
DATA_DIR=./data
LOG_DIR=./logs

# User and Group IDs
# IMPORTANT: Set these to match your host user to avoid permission issues
# Run these commands to get your IDs:
#   id -u    # Your User ID
#   id -g    # Your Group ID
# Then uncomment and set the values below:
#USER_ID=1000
#GROUP_ID=1000
