# Environment Configuration
# Copy this file to .env and adjust the values

# Environment: development or production
# - development: Installs dev dependencies, more verbose logging
# - production: Production dependencies only, optimized autoloader
ENV=production

# Nginx Port
# The port on which Nginx will be accessible on the host
NGINX_PORT=8080

# Log Directory
# Path where logs will be stored (relative or absolute)
LOG_DIR=./logs

# Data Directory
# Path where image data will be stored (relative or absolute)
DATA_DIR=./data

# User and Group IDs
# IMPORTANT: Set these to match your host user to avoid permission issues
# Run these commands to get your IDs:
#   id -u    # Your User ID
#   id -g    # Your Group ID
# Then uncomment and set the values below:
#USER_ID=1000
#GROUP_ID=1000
