# GOSS Test Preset: Production Full-Stack with MariaDB
# PHP + Node.js + MariaDB + Redis (Production Mode)
#
# Tests production configuration with MariaDB instead of PostgreSQL.

COMPOSE_PROJECT_NAME=zappzarapp-goss-prod-fullstack-mariadb
ENV=production

# Core Services
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode
NODE_MODE=assets-api

# Database (MariaDB)
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=59080
NGINX_SSL_PORT=59443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_MINIO=false
ENABLE_RABBITMQ=false
