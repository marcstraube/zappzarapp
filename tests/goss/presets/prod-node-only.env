# GOSS Test Preset: Production Node-Only
# Node.js + PostgreSQL + Redis (Production Mode)
#
# Pure Node.js application stack without PHP.

COMPOSE_PROJECT_NAME=zappzarapp-goss-prod-node-only
ZAPPZARAPP_ENV=production

# Core Services
ENABLE_PHP=false
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode
NODE_MODE=api

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports (30xxx range for production presets)
NGINX_PORT=32080
NGINX_SSL_PORT=32443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_SEAWEEDFS=false
ENABLE_RABBITMQ=false
