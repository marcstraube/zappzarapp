# GOSS Test Preset: Node-Only
# Node.js + Database + Redis (no PHP)
#
# Pure Node.js application stack.
# Suitable for Express API or frontend framework applications.

COMPOSE_PROJECT_NAME=zappzarapp-goss-node-only
ENV=development

# Core Services
ENABLE_PHP=false
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode
NODE_MODE=api

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=12080
NGINX_SSL_PORT=12443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_MINIO=false
ENABLE_RABBITMQ=false
