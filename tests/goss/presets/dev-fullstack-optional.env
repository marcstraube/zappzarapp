# GOSS Test Preset: Full-Stack with Optional Services
# PHP + Node.js + PostgreSQL + Redis + All Optional Services
#
# Complete configuration with all services enabled.
# Used for comprehensive testing of the entire stack including optional services.

COMPOSE_PROJECT_NAME=zappzarapp-goss-fullstack-optional
ENV=development

# Core Services
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode
NODE_MODE=assets-api

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=15080
NGINX_SSL_PORT=15443

# Optional Services (all enabled)
ENABLE_MERCURE=true
ENABLE_MEILISEARCH=true
ENABLE_ELASTICSEARCH=true
ENABLE_MAILPIT=true
ENABLE_SEAWEEDFS=true
ENABLE_RABBITMQ=true
