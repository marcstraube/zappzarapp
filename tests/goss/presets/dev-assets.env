# GOSS Test Preset: Assets Only (Vite)
# PHP + Node.js (Vite HMR only, no Express) + Database + Redis
#
# Configuration for frontend development with Vite HMR but without Express API.
# Use case: PHP backend with Vite-bundled frontend assets.

COMPOSE_PROJECT_NAME=zappzarapp-goss-assets
ENV=development

# Core Services
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode (Vite only, no Express)
NODE_MODE=assets

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=88080
NGINX_SSL_PORT=88443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_MINIO=false
ENABLE_RABBITMQ=false
