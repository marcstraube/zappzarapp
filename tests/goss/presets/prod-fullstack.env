# GOSS Test Preset: Production Full-Stack
# PHP + Node.js + PostgreSQL + Redis (Production Mode)
#
# Tests production configuration with optimized builds,
# security hardening, and no development tools.

COMPOSE_PROJECT_NAME=zappzarapp-goss-prod-fullstack
ENV=production

# Core Services
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode
NODE_MODE=assets-api

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=19080
NGINX_SSL_PORT=19443

# Optional Services (disabled for faster tests)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_MINIO=false
ENABLE_RABBITMQ=false
