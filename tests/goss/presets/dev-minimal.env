# GOSS Test Preset: Minimal
# Nginx only (static/JAMstack)
#
# Minimal configuration with only nginx serving static files.
# Suitable for static sites, SPAs with external APIs, or JAMstack.

COMPOSE_PROJECT_NAME=zappzarapp-goss-minimal
ENV=development

# Core Services
ENABLE_PHP=false
ENABLE_NODE=false
ENABLE_DATABASE=false
ENABLE_REDIS=false

# Ports
NGINX_PORT=48080
NGINX_SSL_PORT=48443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_MINIO=false
ENABLE_RABBITMQ=false
