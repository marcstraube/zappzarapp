# GOSS Test Preset: Production Minimal
# Nginx only (Production Mode)
#
# Minimal production configuration with only nginx serving static files.

COMPOSE_PROJECT_NAME=zappzarapp-goss-prod-minimal
ENV=production

# Core Services
ENABLE_PHP=false
ENABLE_NODE=false
ENABLE_DATABASE=false
ENABLE_REDIS=false

# Ports
NGINX_PORT=49080
NGINX_SSL_PORT=49443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_MINIO=false
ENABLE_RABBITMQ=false
