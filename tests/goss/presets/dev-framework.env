# GOSS Test Preset: Framework Mode
# Node.js Frontend Framework + Express API + Database + Redis
#
# Configuration for frontend framework mode (Nuxt, Next.js, SvelteKit, Remix).
# Tests both node-frontend and node-backend containers.

COMPOSE_PROJECT_NAME=zappzarapp-goss-framework
ENV=development

# Core Services
ENABLE_PHP=false
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode (framework with API)
NODE_MODE=framework-api

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=16080
NGINX_SSL_PORT=16443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_SEAWEEDFS=false
ENABLE_RABBITMQ=false
