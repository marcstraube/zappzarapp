# GOSS Test Preset: Full-Stack
# PHP + Node.js + Database + Redis
#
# This is the default full-stack configuration with all core services enabled.
# Used for comprehensive testing of the complete application stack.

COMPOSE_PROJECT_NAME=zappzarapp-goss-fullstack
ZAPPZARAPP_ENV=development

# Core Services
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode
NODE_MODE=assets-api

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=10080
NGINX_SSL_PORT=10443

# Optional Services (disabled for faster tests)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_SEAWEEDFS=false
ENABLE_RABBITMQ=false
