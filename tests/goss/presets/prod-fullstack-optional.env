# GOSS Test Preset: Production Full-Stack with Optional Services
# PHP + Node.js + PostgreSQL + Redis + All Optional Services (Production Mode)
#
# Complete production configuration with all services enabled.

COMPOSE_PROJECT_NAME=zappzarapp-goss-prod-fullstack-optional
ENV=production

# Core Services
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode
NODE_MODE=assets-api

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports (30xxx range for production presets)
NGINX_PORT=35080
NGINX_SSL_PORT=35443

# Optional Services (all enabled)
ENABLE_MERCURE=true
ENABLE_MEILISEARCH=true
ENABLE_ELASTICSEARCH=true
ENABLE_MAILPIT=true
ENABLE_SEAWEEDFS=true
ENABLE_RABBITMQ=true
