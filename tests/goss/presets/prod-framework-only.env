# GOSS Test Preset: Framework-Only Mode (Production)
# Node.js Frontend Framework WITHOUT backend API
#
# Tests the static health fallback when:
# - ENABLE_PHP=false (no PHP backend)
# - ENABLE_NODE=true (Node enabled)
# - NODE_MODE=framework (only frontend, NO backend)
#
# Expected health routing: Static nginx response

COMPOSE_PROJECT_NAME=zappzarapp-goss-prod-framework-only
ENV=production

# Core Services
ENABLE_PHP=false
ENABLE_NODE=true
ENABLE_DATABASE=false
ENABLE_REDIS=false

# Node.js Mode (framework ONLY - no backend!)
NODE_MODE=framework

# Ports
NGINX_PORT=17080
NGINX_SSL_PORT=17443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_MINIO=false
ENABLE_RABBITMQ=false
