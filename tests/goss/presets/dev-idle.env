# GOSS Test Preset: Idle Mode
# PHP + Node.js (idle) + Database + Redis
#
# Node container runs but stays idle - useful for manual npm/pnpm commands
# or testing container startup without running any Node.js services.

COMPOSE_PROJECT_NAME=zappzarapp-goss-idle
ZAPPZARAPP_ENV=development

# Core Services
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode (idle - container runs but no services)
NODE_MODE=idle

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=18080
NGINX_SSL_PORT=18443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_SEAWEEDFS=false
ENABLE_RABBITMQ=false
