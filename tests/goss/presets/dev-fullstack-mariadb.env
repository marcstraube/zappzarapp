# GOSS Test Preset: Full-Stack with MariaDB
# PHP + Node.js + MariaDB + Redis
#
# Full-stack configuration using MariaDB instead of PostgreSQL.
# Tests MariaDB-specific functionality.

COMPOSE_PROJECT_NAME=zappzarapp-goss-fullstack-mariadb
ZAPPZARAPP_ENV=development

# Core Services
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Node.js Mode
NODE_MODE=assets-api

# Database (MariaDB)
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=14080
NGINX_SSL_PORT=14443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_SEAWEEDFS=false
ENABLE_RABBITMQ=false
