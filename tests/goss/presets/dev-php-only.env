# GOSS Test Preset: PHP-Only
# PHP + Database + Redis (no Node.js)
#
# Traditional PHP application stack without Node.js.
# Suitable for legacy applications or when frontend is served by PHP.

COMPOSE_PROJECT_NAME=zappzarapp-goss-php-only
ENV=development

# Core Services
ENABLE_PHP=true
ENABLE_NODE=false
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports
NGINX_PORT=28080
NGINX_SSL_PORT=28443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_MINIO=false
ENABLE_RABBITMQ=false
