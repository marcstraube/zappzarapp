# GOSS Test Preset: Production PHP-Only
# PHP + PostgreSQL + Redis (Production Mode)
#
# Traditional PHP application stack without Node.js.

COMPOSE_PROJECT_NAME=zappzarapp-goss-prod-php-only
ZAPPZARAPP_ENV=production

# Core Services
ENABLE_PHP=true
ENABLE_NODE=false
ENABLE_DATABASE=true
ENABLE_REDIS=true

# Database
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=app
DB_USER=app

# Redis
REDIS_URL=rediss://redis:6379

# Ports (30xxx range for production presets)
NGINX_PORT=31080
NGINX_SSL_PORT=31443

# Optional Services (disabled)
ENABLE_MERCURE=false
ENABLE_MEILISEARCH=false
ENABLE_ELASTICSEARCH=false
ENABLE_MAILPIT=false
ENABLE_SEAWEEDFS=false
ENABLE_RABBITMQ=false
