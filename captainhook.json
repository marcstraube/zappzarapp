{
  "commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "pnpm exec commitlint --edit $1",
        "options": [],
        "type": "cli",
        "description": "Validate commit message format with commitlint"
      }
    ]
  },
  "pre-commit": {
    "enabled": true,
    "actions": [
      {
        "action": "vendor/bin/php-cs-fixer fix --diff --config=.php-cs-fixer.dist.php --dry-run",
        "options": [],
        "type": "cli",
        "description": "Check for styling issues with PHP-CS-Fixer (Dry-Run)"
      },
      {
        "action": "git diff --name-only --cached | grep .php$ | xargs -r -n1 php -l",
        "options": [],
        "type": "cli",
        "description": "Check for basic PHP syntax errors (Linting)"
      },
      {
        "action": "pnpm exec prettier --check 'src/**/*.{ts,js,json}'",
        "options": [],
        "type": "cli",
        "description": "Check Node.js code formatting with Prettier"
      },
      {
        "action": "pnpm exec eslint 'src/**/*.{ts,js}' --max-warnings=0",
        "options": [],
        "type": "cli",
        "description": "Lint Node.js code with ESLint (TypeScript-aware)"
      },
      {
        "action": "pnpm run type-check",
        "options": [],
        "type": "cli",
        "description": "Check TypeScript types (similar to PHPStan)"
      }
    ]
  },
  "pre-push": {
    "enabled": true,
    "actions": [
      {
        "action": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "options": [],
        "type": "cli",
        "description": "Run PHPStan (Level 5) before pushing to remote"
      },
      {
        "action": "pnpm test",
        "options": [],
        "type": "cli",
        "description": "Run Vitest tests (Node.js unit & integration tests)"
      }
    ]
  },
  "post-checkout": {
    "enabled": true,
    "actions": []
  },
  "post-merge": {
    "enabled": true,
    "actions": []
  },
  "post-rewrite": {
    "enabled": true,
    "actions": []
  }
}