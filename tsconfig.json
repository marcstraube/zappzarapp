{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* Output */
    "outDir": "./dist",

    /* Emit Settings */
    "removeComments": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Path Mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@backend/*": ["./src/node/backend/*"],
      "@tests/*": ["./tests/node/backend/*"]
    }
  },
  "include": [
    "src/node/backend/**/*",
    "tests/node/backend/**/*",
    "vite.config.js",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vendor",
    "build",
    "tests/php",
    "src/node/frontend"
  ]
}
