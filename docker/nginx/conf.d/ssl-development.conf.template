# ============================================================================
# NGINX SSL/TLS CONFIGURATION - DEVELOPMENT
# ============================================================================
# Zero-config SSL/TLS enabled by default.
#
# Features:
# - Automatic HTTP → HTTPS redirect (Port 8080 → 8443)
# - Self-signed certificates auto-generated via 'make setup'
# - Dynamic port configuration via ${NGINX_SSL_PORT} environment variable
# - Template processed by entrypoint script using envsubst
#
# Configuration:
# - Change HTTPS port: Edit NGINX_SSL_PORT in .env (default: 8443)
# - Regenerate certificates: make ssl-selfsigned
# - Production setup: Use 'make ssl-prod-enable' + Let's Encrypt
#
# Note: Browser will show certificate warning for self-signed certs (expected)
# ============================================================================

# HTTP to HTTPS redirect
server {
    listen 8080;
    listen [::]:8080;
    server_name localhost 127.0.0.1;

    location / {
        return 301 https://$host:${NGINX_SSL_PORT}$request_uri;
    }
}

# HTTPS Server
server {
    listen ${NGINX_SSL_PORT} ssl;
    listen [::]:${NGINX_SSL_PORT} ssl;
    http2 on;
    server_name localhost 127.0.0.1;

    # SSL Certificate (self-signed for development)
    ssl_certificate /etc/nginx/certs/cert.crt;
    ssl_certificate_key /etc/nginx/certs/cert.key;

    # Modern SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;

    # SSL Session
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Docker's internal DNS resolver
    resolver 127.0.0.11 valid=30s ipv6=off;

    root /var/www/html/public;
    index index.php index.html;

    # Rate Limiting
    limit_req zone=general burst=20 nodelay;
    limit_conn addr 10;

    # Logging
    access_log /var/log/nginx/access_ssl.log;
    error_log /var/log/nginx/error_ssl.log;

    # Security Headers (Development-friendly - no strict CSP)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Custom Error Pages
    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/50x.html;

    location ^~ /errors/ {
        internal;
        alias /usr/share/nginx/html/errors/;
    }

    # ============================================================================
    # VITE HMR PROXY (DEVELOPMENT ONLY)
    # ============================================================================
    # Vite HMR WebSocket
    location /@vite/client {
        set $upstream_node node:5173;
        proxy_pass http://$upstream_node;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Vite Dev Server (JS/CSS/Images)
    location ~ ^/(js|css|images)/ {
        set $upstream_node node:5173;
        proxy_pass http://$upstream_node;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
    # ============================================================================

    # ============================================================================
    # API DOCUMENTATION (DEVELOPMENT ONLY)
    # ============================================================================
    location = /docs {
        return 301 /docs/;
    }

    location ^~ /docs/ {
        alias /var/www/html/docs/;
        autoindex on;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache, must-revalidate";
    }
    # ============================================================================

    # ============================================================================
    # NODE.JS BACKEND API PROXY
    # ============================================================================
    # Node.js API endpoints (/api/node/* -> /api/*)
    location ~ ^/api/node/(.*)$ {
        set $upstream_backend node:3000;
        proxy_pass http://$upstream_backend/api/$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffering
        proxy_buffering off;
        proxy_request_buffering off;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Node.js Health Check
    location = /api/node/health {
        access_log off;
        set $upstream_backend node:3000;
        proxy_pass http://$upstream_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
    # ============================================================================

    # Standard Location
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # API Endpoints (PHP fallback for non-Node routes)
    location ~ ^/api/ {
        limit_req zone=api burst=10 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Health Check Endpoint
    location = /health {
        access_log off;
        try_files /health.php =404;
        fastcgi_pass unix:/var/run/php-fpm/php-fpm.sock;
        fastcgi_index health.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/health.php;
        fastcgi_param SCRIPT_NAME /health.php;
    }

    # Static files caching
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        limit_req zone=assets burst=100 nodelay;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # PHP-FPM Handler (Unix Socket for better security and performance)
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/var/run/php-fpm/php-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 95;
    }

    # Deny Access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Deny Access to Composer/Git files
    location ~ /(composer\.json|composer\.lock|\.git) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Deny access to sensitive files
    location ~* \.(env|log|sql|bak|swp)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
}
