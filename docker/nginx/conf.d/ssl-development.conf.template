# ============================================================================
# NGINX SSL/TLS CONFIGURATION - DEVELOPMENT
# ============================================================================
# Zero-config SSL/TLS enabled by default.
#
# Features:
# - Automatic HTTP → HTTPS redirect (Port 8080 → 8443)
# - Self-signed certificates auto-generated via 'make setup'
# - Dynamic port configuration via ${NGINX_SSL_PORT} environment variable
# - Template processed by entrypoint script using envsubst
#
# Configuration:
# - Change HTTPS port: Edit NGINX_SSL_PORT in .env (default: 8443)
# - Regenerate certificates: make ssl-selfsigned
# - Production setup: Use 'make ssl-prod-enable' + Let's Encrypt
#
# Note: Browser will show certificate warning for self-signed certs (expected)
# ============================================================================

# HTTP to HTTPS redirect
server {
    listen 8080;
    listen [::]:8080;
    server_name localhost 127.0.0.1;

    location / {
        return 301 https://$host:${NGINX_SSL_PORT}$request_uri;
    }
}

# HTTPS Server
server {
    listen ${NGINX_SSL_PORT} ssl;
    listen [::]:${NGINX_SSL_PORT} ssl;
    http2 on;
    server_name localhost 127.0.0.1;

    # SSL Certificate (self-signed for development)
    ssl_certificate /etc/nginx/certs/cert.crt;
    ssl_certificate_key /etc/nginx/certs/cert.key;

    # SSL/TLS Settings (shared)
    include /etc/nginx/snippets/ssl-settings.conf;

    # Docker's internal DNS resolver
    resolver 127.0.0.11 valid=30s ipv6=off;

    root /var/www/html/public;
    index ${INDEX_DIRECTIVE};

    # Rate Limiting & Logging (shared)
    include /etc/nginx/snippets/server-defaults.conf;

    # Security Headers (shared)
    include /etc/nginx/snippets/security-headers.conf;

    # CRITICAL SECURITY NOTE:
    # The Content-Security-Policy (CSP) below is DEVELOPMENT-OPTIMIZED.
    # It allows Vite HMR from localhost:5173 for Development.
    #
    # !!! FOR PRODUCTION, YOU MUST USE A STRICTER CSP !!!
    #
    # Production CSP should:
    # 1. Remove localhost:5173 from script-src and connect-src
    # 2. Use Nonce-based CSP (see index.php for implementation)
    # 3. Remove 'unsafe-inline' and 'unsafe-eval' directives
    #
    # Development CSP (current):
    # Note: 'unsafe-eval' is required for Vite's Hot Module Replacement (HMR)
    # Note: 'data:' in img-src allows base64 encoded images (e.g., phpinfo logos)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://localhost:${NGINX_SSL_PORT}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://localhost:${NGINX_SSL_PORT} https://localhost:${NGINX_SSL_PORT};" always;

    # Custom Error Pages (shared)
    include /etc/nginx/snippets/error-pages.conf;

    # ============================================================================
    # VITE HMR PROXY (DEVELOPMENT ONLY)
    # ============================================================================
    # These locations proxy Vite dev server for Hot Module Replacement.
    # In Production, these URLs are never called, so they're harmless.
    # The node container runs on port 5173 only in Development mode.

    # Vite HMR WebSocket
    location /@vite/client {
        set $upstream_node node:5173;
        proxy_pass http://$upstream_node;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        # Note: Vite returns 404 status with valid JS body - don't intercept
        proxy_intercept_errors off;
    }

    # Vite Dev Server (JS/CSS/Images)
    location ~ ^/(js|css|images)/ {
        set $upstream_node node:5173;
        proxy_pass http://$upstream_node;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        # Note: Vite returns 404 status with valid JS body - don't intercept
        proxy_intercept_errors off;
    }

    # Vite Internal Routes (filesystem, module IDs, node_modules)
    location ~ ^/(@fs|@id|@vite|node_modules)/ {
        set $upstream_node node:5173;
        proxy_pass http://$upstream_node;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_intercept_errors off;
    }
    # ============================================================================

    # ============================================================================
    # API DOCUMENTATION (DEVELOPMENT ONLY)
    # ============================================================================
    location = /docs {
        return 301 /docs/;
    }

    # Docsify guides (rendered Markdown documentation)
    location ^~ /docs/guides/ {
        alias /var/www/html/.zappzarapp/docs/;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location ^~ /docs/ {
        alias /var/www/html/docs/;
        autoindex on;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache, must-revalidate";
    }
    # ============================================================================

    # Node.js Backend API Proxy (shared)
    include /etc/nginx/snippets/node-backend-proxy.conf;

    # Node.js Frontend Framework Proxy (shared)
    include /etc/nginx/snippets/node-frontend-proxy.conf;

    # Standard Location
    # Fallback configured by entrypoint based on ENABLE_PHP (index.php or index.html)
    location / {
        try_files $uri $uri/ ${TRY_FILES_FALLBACK};
    }

    # API Endpoints - Stricter Rate Limiting, JSON errors (no HTML error pages)
    location ~ ^/api/ {
        limit_req zone=api burst=10 nodelay;
        try_files $uri /index.php?$query_string;

        # Nested PHP handler for API - keeps JSON error responses
        location ~ \.php$ {
            fastcgi_intercept_errors off;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass unix:/var/run/php-fpm/php-fpm.sock;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
            fastcgi_param HTTPS on;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
            fastcgi_read_timeout 95;
        }
    }

    # Health Check Endpoint (generated by entrypoint based on ENABLE_PHP)
    include /run/nginx/snippets/health-check.conf;

    # Static files caching (no caching in development)
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        limit_req zone=assets burst=100 nodelay;
        expires -1;
        add_header Cache-Control "no-cache";
        access_log off;
        try_files $uri =404;
    }

    # PHP-FPM Handler (Unix Socket for better security and performance)
    # Existing .php files are executed directly, non-existent ones route through index.php
    location ~ \.php$ {
        try_files $uri @php_router;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/var/run/php-fpm/php-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 95;
    }

    # Fallback for non-existent .php files - route through PHP router
    location @php_router {
        fastcgi_pass unix:/var/run/php-fpm/php-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param HTTPS on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 95;
    }

    # Deny Rules (shared)
    include /etc/nginx/snippets/deny-rules.conf;
}
