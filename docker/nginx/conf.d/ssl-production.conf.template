# ============================================================================
# NGINX SSL/TLS CONFIGURATION - PRODUCTION
# ============================================================================
# Production-ready SSL configuration with strict security settings.
# This is a template file - use "make ssl-prod-enable" to generate the config.
#
# IMPORTANT: This template includes all stack options (PHP, Node.js backend,
# Node.js frontend). Customize based on your production stack by removing or
# adjusting sections you don't need. See .zappzarapp/docs/infrastructure/NGINX.md
# for detailed guidance on production customization.
#
# Required environment variable:
#   DOMAIN - Your domain (e.g., example.com)
#
# Usage:
#   make ssl-prod-enable
# ============================================================================

# HTTP to HTTPS redirect
server {
    listen 8080;
    listen [::]:8080;
    server_name ${DOMAIN} www.${DOMAIN};

    # Allow Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Health check endpoint (no redirect for container health checks)
    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"nginx","timestamp":"$time_iso8601"}';
    }

    # Redirect all other traffic to HTTPS
    location / {
        return 301 https://$host:${NGINX_SSL_PORT}$request_uri;
    }
}

# HTTPS Server
server {
    listen ${NGINX_SSL_PORT} ssl;
    listen [::]:${NGINX_SSL_PORT} ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    # SSL Certificate paths
    ssl_certificate /etc/nginx/certs/cert.crt;
    ssl_certificate_key /etc/nginx/certs/cert.key;

    # SSL/TLS Settings (shared)
    include /etc/nginx/snippets/ssl-settings.conf;

    # OCSP Stapling (for Let's Encrypt certificates)
    # Uncomment these lines when using Let's Encrypt:
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;
    # resolver 8.8.8.8 8.8.4.4 valid=300s;
    # resolver_timeout 5s;

    # Docker's internal DNS resolver for dynamic upstream resolution
    resolver 127.0.0.11 valid=30s ipv6=off;

    root /var/www/html/public;
    index ${INDEX_DIRECTIVE};

    # Rate Limiting & Logging (shared)
    include /etc/nginx/snippets/server-defaults.conf;

    # Security Headers (shared)
    include /etc/nginx/snippets/security-headers.conf;

    # HSTS (HTTP Strict Transport Security) - 1 year (production only)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Content-Security-Policy (Strict for production)
    # Adjust based on your application's needs
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;

    # Custom Error Pages (shared)
    include /etc/nginx/snippets/error-pages.conf;

    # Node.js Backend API Proxy (shared)
    include /etc/nginx/snippets/node-backend-proxy.conf;

    # Node.js Frontend Framework Proxy (shared)
    include /etc/nginx/snippets/node-frontend-proxy.conf;

    # Standard Location
    # Fallback configured by entrypoint based on ENABLE_PHP (index.php or index.html)
    location / {
        try_files $uri $uri/ ${TRY_FILES_FALLBACK};
    }

    # API Endpoints - Stricter Rate Limiting, JSON errors (no HTML error pages)
    location ~ ^/api/ {
        limit_req zone=api burst=10 nodelay;
        try_files $uri /index.php?$query_string;

        # Nested PHP handler for API - keeps JSON error responses
        location ~ \.php$ {
            fastcgi_intercept_errors off;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass unix:/var/run/php-fpm/php-fpm.sock;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
            fastcgi_param HTTPS on;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
            fastcgi_read_timeout 95;
        }
    }

    # Health Check Endpoint (generated by entrypoint based on ENABLE_PHP)
    include /run/nginx/snippets/health-check.conf;

    # Static files caching
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        limit_req zone=assets burst=100 nodelay;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # PHP-FPM Handler
    # Existing .php files are executed directly, non-existent ones route through index.php
    location ~ \.php$ {
        try_files $uri @php_router;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/var/run/php-fpm/php-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 95;
    }

    # Fallback for non-existent .php files - route through PHP router
    location @php_router {
        fastcgi_pass unix:/var/run/php-fpm/php-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param HTTPS on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 95;
    }

    # Deny Rules (shared)
    include /etc/nginx/snippets/deny-rules.conf;
}
