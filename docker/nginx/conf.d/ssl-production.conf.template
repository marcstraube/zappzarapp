# ============================================================================
# NGINX SSL/TLS CONFIGURATION - PRODUCTION
# ============================================================================
# Production-ready SSL configuration with strict security settings.
# This is a template file - use "make ssl-prod-enable" to generate the config.
#
# Required environment variable:
#   DOMAIN - Your domain (e.g., example.com)
#
# Usage:
#   make ssl-prod-enable
# ============================================================================

# HTTP to HTTPS redirect
server {
    listen 8080;
    listen [::]:8080;
    server_name ${DOMAIN} www.${DOMAIN};

    # Allow Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all other traffic to HTTPS
    location / {
        return 301 https://$host:${NGINX_SSL_PORT}$request_uri;
    }
}

# HTTPS Server
server {
    listen ${NGINX_SSL_PORT} ssl;
    listen [::]:${NGINX_SSL_PORT} ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    # SSL Certificate paths
    ssl_certificate /etc/nginx/certs/cert.crt;
    ssl_certificate_key /etc/nginx/certs/cert.key;

    # Modern SSL configuration (Mozilla Intermediate)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers off;

    # SSL Session
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # OCSP Stapling (for Let's Encrypt certificates)
    # Uncomment these lines when using Let's Encrypt:
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # ssl_trusted_certificate /etc/letsencrypt/live/${DOMAIN}/chain.pem;
    # resolver 8.8.8.8 8.8.4.4 valid=300s;
    # resolver_timeout 5s;

    # Docker's internal DNS resolver for dynamic upstream resolution
    resolver 127.0.0.11 valid=30s ipv6=off;

    root /var/www/html/public;
    index index.php index.html;

    # Enable Rate Limiting (General Zone - default for all locations)
    limit_req zone=general burst=20 nodelay;
    limit_conn addr 10;

    # Logging
    access_log /var/log/nginx/access_ssl.log;
    error_log /var/log/nginx/error_ssl.log;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # HSTS (HTTP Strict Transport Security) - 1 year
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Content-Security-Policy (Strict for production)
    # Adjust based on your application's needs
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" always;

    # Custom Error Pages
    error_page 404 /errors/404.html;
    error_page 500 502 503 504 /errors/50x.html;

    location ^~ /errors/ {
        internal;
        alias /usr/share/nginx/html/errors/;
    }

    # ============================================================================
    # NODE.JS BACKEND API PROXY
    # ============================================================================
    # Routes requests to Node.js backend server (Express/Fastify/etc.)
    # These locations are always active but only work when Node container is running.
    # If Node is not running, requests to /api/node/* return 502 Bad Gateway.

    # Node.js API endpoints - JSON errors (no HTML error pages)
    location ~ ^/api/node/(.*)$ {
        set $upstream_backend node:3000;
        proxy_pass http://$upstream_backend/api/$1$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # Keep JSON error responses from Node.js
        proxy_intercept_errors off;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffering
        proxy_buffering off;
        proxy_request_buffering off;

        # WebSocket support (if needed for Socket.IO, etc.)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Node.js Health Check
    location = /api/node/health {
        access_log off;
        set $upstream_backend node:3000;
        proxy_pass http://$upstream_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
    # ============================================================================

    # Standard Location
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # API Endpoints - Stricter Rate Limiting, JSON errors (no HTML error pages)
    location ~ ^/api/ {
        limit_req zone=api burst=10 nodelay;
        try_files $uri /index.php?$query_string;

        # Nested PHP handler for API - keeps JSON error responses
        location ~ \.php$ {
            fastcgi_intercept_errors off;
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass php:9000;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
            fastcgi_param HTTPS on;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
            fastcgi_read_timeout 95;
        }
    }

    # Health Check Endpoint
    # Tries PHP first (for full health check), falls back to static JSON (Nginx-only mode)
    location = /health {
        access_log off;
        try_files /health.php @nginx_health;
        fastcgi_pass php:9000;
        fastcgi_index health.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/health.php;
        fastcgi_param SCRIPT_NAME /health.php;
        fastcgi_param HTTPS on;
    }

    # Fallback health check when PHP is not available (static/JAMstack mode)
    location @nginx_health {
        default_type application/json;
        return 200 '{"status":"ok","service":"nginx","timestamp":"$time_iso8601"}';
    }

    # Static files caching - More generous rate limiting
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        limit_req zone=assets burst=100 nodelay;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # PHP-FPM Handler
    # Existing .php files are executed directly, non-existent ones route through index.php
    location ~ \.php$ {
        try_files $uri @php_router;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTPS on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 95;
    }

    # Fallback for non-existent .php files - route through PHP router
    location @php_router {
        fastcgi_pass php:9000;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param HTTPS on;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_read_timeout 95;
    }

    # Deny Access to hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Deny Access to Composer/Git files
    location ~ /(composer\.json|composer\.lock|\.git) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Deny access to sensitive files
    location ~* \.(env|log|sql|bak|swp)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
}
