{
  "$schema": "https://json.schemastore.org/depcheckrc",
  "ignorePatterns": [
    "build",
    "dist",
    "docs",
    "coverage"
  ],
  "ignores": [
    "@types/*",
    "tsx",
    "typescript",
    "vitest",
    "@vitest/*",
    "eslint",
    "eslint-*",
    "@eslint/*",
    "@typescript-eslint/*",
    "prettier",
    "prettier-plugin-toml",
    "postcss",
    "autoprefixer",
    "sass",
    "typedoc",
    "pm2",
    "lint-staged",
    "markdownlint-cli2",
    "@commitlint/*",
    "vite",
    "pino-pretty",
    "ws",
    "depcheck",
    "knip",
    "@faker-js/faker",
    "ai-command-converter",
    "rulesync",
    "standard-version",
    "amqplib",
    "meilisearch",
    "redis",
    "@zappzarapp/browser-utils"
  ],
  "skip-missing": true
}
