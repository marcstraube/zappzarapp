# ============================================================================
# LOCAL ENVIRONMENT OVERRIDES
# ============================================================================
# Copy to .env.local and adjust as needed
# .env.local is gitignored and overrides .env values
#
# Use this file to:
# - Override settings for local development
# - Test with different configurations
# - Add development-only features
#
# IMPORTANT: Never commit .env.local (contains personal settings/secrets)

# ============================================================================
# USER/GROUP IDs (Docker Volume Permissions)
# ============================================================================
# Adjust to match your host user (run: id -u && id -g)
USER_ID=1000
GROUP_ID=1000

# ============================================================================
# PORT OVERRIDES
# ============================================================================
# Uncomment to override ports if conflicts exist:
#POSTGRES_PORT=5433
#MARIADB_PORT=3307
#NGINX_PORT=8081

# ============================================================================
# SSH TUNNEL FOR REMOTE DATABASE (Personal Credentials)
# ============================================================================
# These enable IDE (PHPStorm) connection to remote databases via SSH tunnel.
# Team-shared settings (DB_REMOTE_HOST, etc.) are in .env or .env.production.
# Your personal SSH credentials go here (never commit!)

#DB_REMOTE_SSH_HOST=bastion.example.com
#DB_REMOTE_SSH_PORT=22
#DB_REMOTE_SSH_USER=your-username
#DB_REMOTE_SSH_KEY=~/.ssh/id_ed25519

# ============================================================================
# DATABASE TOOLS (Development Only)
# ============================================================================
# Web-based database administration tools.
# Start automatically with 'make up' when enabled.

# Adminer - Universal database admin (PostgreSQL, MariaDB, SQLite)
# Access: https://localhost:8443/_dev/adminer/
ENABLE_ADMINER=true

# pgAdmin - Full-featured PostgreSQL management
# Access: https://localhost:8443/_dev/pgadmin/
ENABLE_PGADMIN=true

# ============================================================================
# CORS CONFIGURATION - Development Overrides
# ============================================================================
# The base .env restricts CORS to localhost only for security.
# Uncomment one of these options if you need different behavior:

# Option 1: Allow all origins (convenient but less secure)
# Use when: Testing mobile apps, external frontend, or cross-origin scenarios
#CORS_ORIGINS=*

# Option 2: Add specific additional origins
# Use when: Working with specific IPs, custom domains, or multiple frontends
#CORS_ORIGINS=https://localhost,https://localhost:5173,http://localhost:3000,http://192.168.1.100:3000

# Option 3: Custom domain(s) for local development
# Use when: Testing with custom hosts file entries (e.g., dev.local)
#CORS_ORIGINS=https://dev.local,https://app.dev.local

# ============================================================================
# OTHER LOCAL OVERRIDES (Examples)
# ============================================================================

# Change Xdebug mode for debugging
#XDEBUG_MODE=develop,debug

# Use pretty logs instead of JSON for local development
#LOG_FORMAT=pretty

# Change log level
#LOG_LEVEL=debug
