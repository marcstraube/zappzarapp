# ============================================================================
# ZAPPZARAPP - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains production-specific values that differ from development.
# It is committed to version control and shared across the team.
#
# IMPORTANT: Do NOT put secrets in this file!
# Secrets belong in:
#   - Docker Secrets (./secrets/)
#   - Environment variables set by your deployment platform
#   - .env.local (gitignored, for local overrides)
#
# Load order: .env -> .env.production (if ZAPPZARAPP_ENV=production) -> .env.local
# ============================================================================

# ----------------------------------------------------------------------------
# PRODUCTION OVERRIDES
# ----------------------------------------------------------------------------
# Only settings that DIFFER from .env defaults

# Logging: Less verbose in production
LOG_LEVEL=warning

# Ports: Standard HTTP/HTTPS ports
NGINX_PORT=80
NGINX_SSL_PORT=443

# Backups: Longer retention
BACKUP_RETENTION_DAYS=90

# ----------------------------------------------------------------------------
# CORS (REQUIRED - set your domain)
# ----------------------------------------------------------------------------
# Uncomment and set your production domain(s):
#CORS_ORIGINS=https://yourdomain.com

# ----------------------------------------------------------------------------
# REMOTE DATABASE ACCESS (IDE - team-shared settings)
# ----------------------------------------------------------------------------
# Remote DB connection (personal SSH credentials go in .env.local)
#DB_REMOTE_HOST=internal-db.k8s.cluster
#DB_REMOTE_PORT=5432
#DB_REMOTE_NAME=production
#DB_REMOTE_USER=app_readonly
