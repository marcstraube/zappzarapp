# ============================================================================
# ZAPPZARAPP - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# This file contains production-specific values that differ from development.
# It is committed to version control and shared across the team.
#
# IMPORTANT: Do NOT put secrets in this file!
# Secrets belong in:
#   - Docker Secrets (./secrets/)
#   - Environment variables set by your deployment platform
#   - .env.local (gitignored, for local overrides)
#
# Load order: .env -> .env.production (if ENV=production) -> .env.local
# ============================================================================

# ----------------------------------------------------------------------------
# ENVIRONMENT MODE
# ----------------------------------------------------------------------------
ENV=production

# ----------------------------------------------------------------------------
# LOGGING (Production settings)
# ----------------------------------------------------------------------------
LOG_LEVEL=warning
LOG_FORMAT=json

# ----------------------------------------------------------------------------
# DEVELOPMENT TOOLS (Disabled in production)
# ----------------------------------------------------------------------------
XDEBUG_MODE=off

# ----------------------------------------------------------------------------
# CORS (Restrict in production)
# ----------------------------------------------------------------------------
# CORS_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ----------------------------------------------------------------------------
# REMOTE DATABASE ACCESS (IDE only)
# ----------------------------------------------------------------------------
# These settings enable PHPStorm to connect to the production database
# via SSH tunnel. Configure your personal SSH credentials in .env.local
#
# Remote DB connection (the actual database behind SSH)
#DB_REMOTE_HOST=internal-db.k8s.cluster
#DB_REMOTE_PORT=5432
#DB_REMOTE_NAME=production
#DB_REMOTE_USER=app_readonly
#
# SSH tunnel settings go in .env.local (personal credentials):
#   DB_REMOTE_SSH_HOST=bastion.example.com
#   DB_REMOTE_SSH_PORT=22
#   DB_REMOTE_SSH_USER=your-username
#   DB_REMOTE_SSH_KEY=~/.ssh/id_ed25519
