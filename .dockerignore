# Git
.git
.gitignore
.gitattributes

# IDE
.idea
.vscode
*.swp
*.swo

# Environment & Secrets
.env
.env.*
!.env.example

# Dependencies (installed in container)
vendor/
node_modules/

# Development artifacts
.phpunit.result.cache
.php-cs-fixer.cache

# Logs
logs/
*.log

# Documentation (exclude markdown files but keep necessary ones)
documentation/
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE.md

