docker-compose*.yml
compose*.yaml
.dockerignore

# CI/CD
.github/
.gitlab/
.gitlab-ci.yml

# Build tools (not needed in container)
Makefile

# Temporary files
tmp/
temp/
*.tmp
*.cache

# Build outputs (generated during build)
build/
dist/
docs/
backups/

# Test coverage
coverage/