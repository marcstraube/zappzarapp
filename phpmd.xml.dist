<?xml version="1.0"?>
<ruleset name="PHPMD Rules"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        PHP Mess Detector configuration for code quality analysis.
        Detects code smells, complexity issues, and design problems.
    </description>

    <!-- Exclude PHP 8.4 asymmetric visibility files (PDepend parser doesn't support them yet) -->
    <exclude-pattern>*/DatabaseConfig.php</exclude-pattern>
    <exclude-pattern>*/DatabaseConfigInterface.php</exclude-pattern>
    <exclude-pattern>*/DatabaseConfigStub.php</exclude-pattern>

    <!-- Clean Code Rules -->
    <rule ref="rulesets/cleancode.xml">
        <!-- Allow else expressions for readability -->
        <exclude name="ElseExpression"/>
        <!-- Allow static access (common in frameworks) -->
        <exclude name="StaticAccess"/>
    </rule>

    <!-- Code Size Rules (Complexity)
         Each rule imported explicitly so its threshold is not also loaded with
         the ruleset's default (PHPMD will otherwise report both "under N" and
         "under our-N" for the same class). -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <!-- Max cyclomatic complexity per method -->
            <property name="reportLevel" value="15"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties>
            <!-- Max number of possible execution paths -->
            <property name="minimum" value="250"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <!-- Max lines per method (excluding comments) -->
            <property name="minimum" value="100"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties>
            <!-- Max lines per class (excluding comments) -->
            <property name="minimum" value="500"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <!-- Max parameters per method -->
            <property name="minimum" value="10"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/TooManyFields">
        <properties>
            <!-- Max fields per class -->
            <property name="maxfields" value="20"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties>
            <!-- Max methods per class -->
            <property name="maxmethods" value="25"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <!-- Max public methods per class -->
            <!-- Raised from default 10 to 20 for practical test coverage -->
            <!-- Sweet spot: enforces focused classes without being too restrictive -->
            <!-- >20 methods indicates class should be split for better organization -->
            <!-- Example: Split by feature area (Nonce, Development, Production, Environment) -->
            <property name="maxmethods" value="20"/>
        </properties>
    </rule>

    <!-- Design Rules -->
    <rule ref="rulesets/design.xml">
        <!-- Allow exit() for CLI tools -->
        <exclude name="ExitExpression"/>
    </rule>

    <!-- Naming Rules -->
    <rule ref="rulesets/naming.xml">
        <!-- Allow short variable names in loops -->
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>

    <!-- Custom Naming Rules -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <!-- Allow 1-char variables like $i, $e in specific contexts -->
            <property name="minimum" value="2"/>
            <property name="exceptions" value="i,j,k,e,id,x,y,a,b"/>
        </properties>
    </rule>

    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <!-- Max variable name length -->
            <property name="maximum" value="30"/>
        </properties>
    </rule>

    <!-- Unused Code Detection -->
    <rule ref="rulesets/unusedcode.xml">
        <!-- Keep all unused code rules - they're important -->
    </rule>

    <!-- Controversial Rules (Disabled - too opinionated) -->
    <!-- <rule ref="rulesets/controversial.xml"/> -->
</ruleset>
