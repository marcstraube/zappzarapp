{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/node"],
  "entryPointStrategy": "expand",
  "out": "docs/api/node",
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/node_modules/**"
  ],
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeExternals": true,
  "readme": "none",
  "name": "Node.js/TypeScript API Documentation",
  "includeVersion": true,
  "sort": ["source-order"],
  "kindSortOrder": [
    "Project",
    "Module",
    "Namespace",
    "Class",
    "Interface",
    "TypeAlias",
    "Function",
    "Variable"
  ],
  "theme": "default"
}
