{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate All-Purpose Config for PHP/Node/Docker projects. For detailed help and options, see: https://docs.renovatebot.com/",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "at any time"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "automerge": true,
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Group every docker-image reference per image across managers (Dockerfile ARG + kubernetes/values.yaml) into one PR, so an image's Dockerfile bump and its Kubernetes tag can never drift apart.",
      "matchDatasources": [
        "docker"
      ],
      "groupName": "{{{depName}}}",
      "automerge": true
    },
    {
      "description": "PHP Composer Updates - Exclude major application frameworks for individual review.",
      "matchManagers": [
        "composer"
      ],
      "groupName": "PHP Composer Dependencies",
      "automerge": true,
      "excludePackageNames": [
        "laravel/framework",
        "symfony/framework-bundle"
      ]
    },
    {
      "description": "Node.js (PNPM) Updates",
      "matchManagers": [
        "pnpm"
      ],
      "groupName": "Node Dependencies",
      "automerge": true
    },
    {
      "description": "Node.js Dev Dependencies Grouping",
      "matchManagers": [
        "pnpm"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "groupName": "Node Dev Dependencies"
    },
    {
      "description": "Immediate merge of security patches (High Priority)",
      "matchUpdateTypes": [
        "patch"
      ],
      "schedule": [
        "at any time"
      ],
      "automerge": true
    },
    {
      "description": "Never automerge major updates - always require manual review (last rule wins).",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
