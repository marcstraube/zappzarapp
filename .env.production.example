# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy to .env.production and configure for your deployment
#
# IMPORTANT:
# - Never commit .env.production (contains production secrets)
# - All values here must be configured before going live
# - Use secure, production-ready settings only

# ============================================================================
# CORS CONFIGURATION - REQUIRED FOR PRODUCTION
# ============================================================================
# CRITICAL: Set your actual domain(s) - NEVER use '*' in production!

# Single domain (most common):
CORS_ORIGINS=https://your-domain.com

# Multiple domains (SPA on different domain, admin panel, mobile app, etc.):
# CORS_ORIGINS=https://your-domain.com,https://api.your-domain.com,https://admin.your-domain.com

# Security Best Practices:
# ✅ Always use HTTPS (never HTTP in production)
# ✅ Only list domains that actually need API access
# ✅ Review and remove unused origins periodically
# ❌ NEVER use '*' (allows any website to make requests)
# ❌ NEVER include development URLs (localhost, .test, .local)

# ============================================================================
# ENVIRONMENT MODE
# ============================================================================
ENV=production

# ============================================================================
# SERVICE ACTIVATION
# ============================================================================
# Enable only services you actually use in production
ENABLE_PHP=true
ENABLE_NODE=true
ENABLE_DATABASE=true
ENABLE_REDIS=true
ENABLE_ELASTICSEARCH=false
ENABLE_MEILISEARCH=false
ENABLE_MERCURE=false
ENABLE_MAILPIT=false

# ============================================================================
# NODE.JS MODE
# ============================================================================
# Production mode (HMR is never available in production - development only)
# Common configurations:
# - assets-api: Pre-built frontend assets + Express API (most common)
# - api: Express API only, no frontend
# - framework: Node framework only (Nuxt/Next.js/etc.)
NODE_MODE=assets-api

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Production database connection
DB_TYPE=postgres
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_NAME=production_db
DB_USER=app_user

# Database passwords via Docker Secrets (recommended):
# - Place password in ./secrets/db_password.txt
# - Ensure compose.yaml uses POSTGRES_PASSWORD_FILE
#
# OR via environment variables (less secure):
# DB_PASSWORD=your_secure_password
# DB_ROOT_PASSWORD=your_root_password

# SSL/TLS for external databases (AWS RDS, Google Cloud SQL, etc.)
DB_SSL_CA=system
DB_SSL_VERIFY=true

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Production Redis (may be external managed service)
REDIS_URL=rediss://redis.example.com:6379
# For managed Redis (AWS ElastiCache, Redis Cloud, etc.):
# REDIS_URL=rediss://:password@redis.example.com:6379

# ============================================================================
# PORT BINDING
# ============================================================================
# Production typically uses standard ports
NGINX_PORT=80
NGINX_SSL_PORT=443

# ============================================================================
# STORAGE
# ============================================================================
# Production should use absolute paths or cloud storage
STORAGE_DIR=/var/www/storage
# Or cloud storage (S3, etc.) - configure S3_* variables below

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================
USER_ID=1000
GROUP_ID=1000
TZ=UTC

# ============================================================================
# LOGGING
# ============================================================================
# Production uses structured JSON logging
LOG_LEVEL=warning
LOG_FORMAT=json

# ============================================================================
# DEVELOPMENT TOOLS - DISABLE IN PRODUCTION
# ============================================================================
XDEBUG_MODE=off

# ============================================================================
# OPTIONAL SERVICES - Configure if enabled above
# ============================================================================

# Elasticsearch (if ENABLE_ELASTICSEARCH=true)
# ELASTICSEARCH_HOST=elasticsearch.example.com
# ELASTICSEARCH_PORT=9200
# ELASTICSEARCH_VERIFY_SSL=true
# ELASTICSEARCH_HEAP_SIZE=2g

# S3-compatible storage (if using)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1

# ============================================================================
# ENCRYPTION & SECURITY
# ============================================================================
# Use Docker Secrets for production (store in ./secrets/)
# Or set environment variables (less secure):
# ENCRYPTION_KEY=your-production-encryption-key
# BACKUP_ENCRYPTION_KEY=your-backup-encryption-key

BACKUP_RETENTION_DAYS=90
