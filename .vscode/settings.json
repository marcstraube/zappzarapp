{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [120],
  "editor.wordWrap": "off",
  "editor.renderWhitespace": "boundary",
  "editor.trimAutoWhitespace": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/vendor": true,
    "**/build": true,
    "**/.phpunit.cache": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/build/**": true,
    "**/.phpunit.cache/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/build": true,
    "**/.phpunit.cache": true,
    "**/composer.lock": true,
    "**/pnpm-lock.yaml": true
  },
  "files.associations": {
    "*.php": "php",
    "composer.lock": "json",
    "*.env.example": "dotenv",
    ".env": "dotenv",
    "Dockerfile*": "dockerfile",
    "docker-compose*.yml": "yaml",
    "docker-compose*.yaml": "yaml"
  },
  "php.suggest.basic": false,
  "php.validate.enable": false,
  "intelephense.diagnostics.enable": true,
  "intelephense.format.enable": false,
  "intelephense.telemetry.enabled": false,
  "intelephense.environment.phpVersion": "8.4.0",
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/node_modules/**",
    "**/vendor/**/tests/**",
    "**/vendor/**/test/**",
    "**/vendor/**/*Test.php",
    "**/build/**"
  ],
  "[php]": {
    "editor.formatOnSave": true,
    "editor.tabSize": 4
  },
  "php-cs-fixer.executablePath": "${workspaceFolder}/vendor/bin/php-cs-fixer",
  "php-cs-fixer.executablePathWindows": "${workspaceFolder}/vendor/bin/php-cs-fixer.bat",
  "php-cs-fixer.onsave": true,
  "php-cs-fixer.rules": "@PER-CS",
  "php-cs-fixer.config": ".php-cs-fixer.dist.php",
  "php-cs-fixer.allowRisky": true,
  "php-cs-fixer.autoFixByBracket": true,
  "php-cs-fixer.autoFixBySemicolon": false,
  "phpstan.enabled": true,
  "phpstan.path": "${workspaceFolder}/vendor/bin/phpstan",
  "phpstan.level": "8",
  "phpstan.configFile": "${workspaceFolder}/phpstan.neon",
  "phpmd.enabled": true,
  "phpmd.command": "${workspaceFolder}/vendor/bin/phpmd",
  "phpmd.rules": "${workspaceFolder}/phpmd.xml.dist",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.wordWrap": "on"
  },
  "markdownlint.config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD046": {
      "style": "fenced"
    },
    "MD024": {
      "siblings_only": true
    },
    "MD055": false
  },
  "markdownlint.ignore": [
    "node_modules/**",
    "vendor/**",
    "build/**",
    "docs/**",
    ".git/**",
    "CHANGELOG.md"
  ],
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "eslint.workingDirectories": ["${workspaceFolder}"],
  "prettier.enable": true,
  "prettier.requireConfig": true,
  "prettier.configPath": "${workspaceFolder}/.prettierrc.json",
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "javascript.suggest.autoImports": true,
  "typescript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "gitlens.advanced.messages": {
    "suppressCommitHasNoPreviousCommitWarning": true
  },
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.linux": {},
  "docker.dockerComposeBuild": true,
  "docker.dockerComposeDetached": true,
  "sqltools.useNodeRuntime": true,
  "sqltools.connections": [
    {
      "name": "PostgreSQL (Docker)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5432,
      "database": "app",
      "username": "app",
      "askForPassword": true
    },
    {
      "name": "MariaDB (Docker)",
      "driver": "MariaDB",
      "server": "localhost",
      "port": 3306,
      "database": "app",
      "username": "app",
      "askForPassword": true
    },
    {
      "name": "PostgreSQL (Remote)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5432,
      "database": "production",
      "username": "app",
      "askForPassword": true
    },
    {
      "name": "MariaDB (Remote)",
      "driver": "MariaDB",
      "server": "localhost",
      "port": 3306,
      "database": "production",
      "username": "app",
      "askForPassword": true
    }
  ],
  "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "NOTE", "@TODO"],
  "todo-tree.highlights.defaultHighlight": {
    "icon": "alert",
    "type": "text",
    "foreground": "#fff",
    "background": "#ffbd2e",
    "opacity": 50,
    "iconColour": "#ffbd2e"
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "iconColour": "#ffbd2e"
    },
    "FIXME": {
      "foreground": "#fff",
      "background": "#f06292",
      "iconColour": "#f06292"
    },
    "BUG": {
      "foreground": "#fff",
      "background": "#f44336",
      "iconColour": "#f44336"
    }
  },
  "cSpell.words": [
    "amqp",
    "amqpchannel",
    "amqplib",
    "amqplain",
    "amqpmessage",
    "amqps",
    "amqpsslconnection",
    "amqptable",
    "apcu",
    "autowiring",
    "buildkit",
    "buildx",
    "captainhook",
    "codepoint",
    "datasource",
    "datetime",
    "devdashboard",
    "doctrine",
    "dockerfile",
    "dotenv",
    "dto",
    "entrypoint",
    "envsubst",
    "esbuild",
    "eslint",
    "falco",
    "fpm",
    "getenv",
    "goss",
    "healthcheck",
    "hmr",
    "httponly",
    "intelephense",
    "jamstack",
    "jsonb",
    "laminas",
    "laravel",
    "mariadb",
    "memcached",
    "mezzio",
    "middlewares",
    "monolog",
    "multibyte",
    "mysqldump",
    "nack",
    "neon",
    "nginx",
    "nitro",
    "nowait",
    "nuxt",
    "opcache",
    "parens",
    "pdo",
    "pgsql",
    "phpcsfixer",
    "phpmd",
    "phpstan",
    "phpunit",
    "pnpm",
    "postgres",
    "postgresql",
    "prefetch",
    "rabbitmq",
    "redis",
    "rediss",
    "requeue",
    "rollup",
    "rootfs",
    "sbom",
    "sslmode",
    "ssr",
    "stderr",
    "stdin",
    "stdout",
    "symfony",
    "tmpfs",
    "tsx",
    "typedoc",
    "urldecode",
    "vhost",
    "vite",
    "vitest",
    "webpack",
    "xdebug",
    "zappzarapp"
  ],
  "cSpell.enabledFileTypes": {
    "dockerfile": true,
    "dotenv": true,
    "yaml": true
  },
  "ltex.enabled": ["markdown", "latex", "restructuredtext"],
  "ltex.language": "en-US",
  "ltex.additionalRules.enablePickyRules": false,
  "ltex.files.include": [
    "documentation/**/*.md",
    "*.md"
  ],
  "ltex.files.exclude": [
    "src/**",
    "tests/**",
    "node_modules/**",
    "vendor/**",
    "build/**",
    "CHANGELOG.md"
  ],
  "ltex.dictionary": {
    "en-US": [
      "amqp",
      "amqplib",
      "RabbitMQ",
      "Redis",
      "PostgreSQL",
      "MariaDB",
      "nginx",
      "PHP",
      "pnpm",
      "Vite",
      "Vitest",
      "PHPStan",
      "PHPMD",
      "PHPUnit",
      "ESLint",
      "TypeScript",
      "Dockerfile",
      "zappzarapp"
    ]
  },
  "containers.composeBuild": true,
  "containers.composeDetached": true
}
