<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>zappzarapp</title>
    <!--suppress HtmlUnknownTarget -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- Vite Assets - Dynamically loaded based on ENV -->
    {{ vite.renderCssTags('js/app.js')|raw }}

</head>
<body>
<div class="container">
    {% if vite.isDevelopment() and not vite.isViteDevServerRunning() %}
    <div class="card" style="background: #fff3cd; border: 2px solid #ffc107; padding: 1rem; margin-bottom: 1rem;">
        <h3 style="color: #856404; margin: 0 0 0.5rem 0;">⚠️ Vite Dev Server Not Running</h3>
        <p style="color: #856404; margin: 0;">
            CSS styles are loaded via Vite HMR in development mode. The page may appear unstyled.
        </p>
        <p style="color: #856404; margin: 0.5rem 0 0 0; font-size: 0.9em;">
            <strong>Fix:</strong> Run <code style="background: #f8f9fa; padding: 0.2rem 0.4rem; border-radius: 3px;">make node-up</code>
            or set <code style="background: #f8f9fa; padding: 0.2rem 0.4rem; border-radius: 3px;">ENABLE_NODE=true</code> in your <code>.env.local</code> file.
        </p>
    </div>
    {% endif %}

    {% if env.ENV == 'development' %}
    <div class="card" style="background: #e7f3ff; border: 2px solid #2196F3; padding: 1rem; margin-bottom: 1rem;">
        <h3 style="color: #1565C0; margin: 0 0 0.5rem 0;">🛠️ Developer Toolbar Demo Active</h3>
        <p style="color: #1565C0; margin: 0; font-size: 0.95em;">
            This page demonstrates all Developer Toolbar features. Click the toolbar in the bottom-right corner to explore:
        </p>
        <ul style="color: #1565C0; margin: 0.5rem 0 0 1.5rem; font-size: 0.9em;">
            <li><strong>REQUEST Tab:</strong> Current request details (method, URI, headers, timing, memory)</li>
            <li><strong>QUERIES Tab:</strong> 9 sample queries including N+1 pattern detection (5 duplicate queries)</li>
            <li><strong>EXCEPTIONS Tab:</strong> 2 handled exceptions (RuntimeException, InvalidArgumentException)</li>
            <li><strong>HTTP Tab:</strong> 3 simulated API calls (fast: 150ms, medium: 350ms, slow: 650ms)</li>
            <li><strong>CACHE Tab:</strong> 7 cache operations (3 hits, 1 miss, 2 sets, 1 delete) - ~75% hit rate</li>
            <li><strong>TIMELINE Tab:</strong> Visual request breakdown with aggregated data from all collectors</li>
            <li><strong>Performance Alerts:</strong> N+1 query warning should be visible in QUERIES tab</li>
        </ul>
        <p style="color: #1565C0; margin: 0.5rem 0 0 0; font-size: 0.85em; font-style: italic;">
            💡 Tip: Open browser DevTools to see the toolbar's JavaScript console logs
        </p>
    </div>
    {% endif %}

    <div class="card text-center">
        <h1>⚡ zappzarapp</h1>
        <p style="font-family: monospace; color: #666; margin: 0.25rem 0;">/ˈt͡sapt͡saˈʁap/</p>
        <p style="font-style: italic; color: #555; margin: 0.5rem 0 1rem 0;">
            German for "in a flash" — a professional web dev stack that gets you coding in minutes.
        </p>

        <div class="card" style="margin-top: 2rem; background: #f0f0f0; padding: 1rem; border-radius: 8px;">
            <h3>Current Environment</h3>
            <p><strong>ENV:</strong> {{ env.ENV }}</p>
            <p><strong>Mode:</strong> {% if vite.isDevelopment() %}🔧 Development (Vite HMR){% else %}🚀 Production (Built Assets){% endif %}</p>
            <p><strong>Overall Status:</strong>
                <span style="color: {% if status.overall_status == 'ok' %}green{% else %}orange{% endif %}; font-weight: bold;">
                    {{ status.overall_status|upper }}
                </span>
            </p>
        </div>
    </div>

    <div class="card">
        <h2>📊 Service Status</h2>
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #f5f5f5;">
                    <th style="padding: 0.5rem; text-align: left; border: 1px solid #ddd;">Service</th>
                    <th style="padding: 0.5rem; text-align: left; border: 1px solid #ddd;">Status</th>
                    <th style="padding: 0.5rem; text-align: left; border: 1px solid #ddd;">Details</th>
                </tr>
            </thead>
            <tbody>
                {% for serviceName, service in status.services %}
                <tr>
                    <td style="padding: 0.5rem; border: 1px solid #ddd;">
                        <strong>{{ serviceName|replace({'-': ' '})|capitalize }}</strong>
                    </td>
                    <td style="padding: 0.5rem; border: 1px solid #ddd;">
                        <span style="color: {% if service.status == 'ok' %}green{% elseif service.status == 'disabled' %}gray{% else %}red{% endif %}; font-weight: bold;">
                            {% if service.status == 'ok' %}✅ OK{% elseif service.status == 'disabled' %}⚪ Disabled{% else %}❌ Error{% endif %}
                        </span>
                    </td>
                    <td style="padding: 0.5rem; border: 1px solid #ddd; font-size: 0.9em;">
                        {% if service.version is defined %}
                            Version: {{ service.version }}<br>
                        {% endif %}
                        {% if service.mode is defined %}
                            Mode: {{ service.mode }}<br>
                        {% endif %}
                        {% if service.message is defined %}
                            <span style="color: red;">{{ service.message }}</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="card">
        <h2>⚙️ Active Features</h2>
        <ul style="list-style: none; padding: 0;">
            <li>🔧 <strong>Environment:</strong> {{ env.ENV }}</li>
            <li>📦 <strong>PHP Service:</strong> {% if env.ENABLE_PHP %}✅ Enabled{% else %}❌ Disabled{% endif %}</li>
            <li>🟢 <strong>Node.js Service:</strong> {% if env.ENABLE_NODE %}✅ Enabled ({{ env.NODE_MODE }}){% else %}❌ Disabled{% endif %}</li>
            <li>🔴 <strong>Redis Service:</strong> {% if env.ENABLE_REDIS %}✅ Enabled{% else %}❌ Disabled{% endif %}</li>
            <li>💾 <strong>Database:</strong> {% if env.ENABLE_DATABASE %}✅ {{ env.DB_TYPE|upper }}{% else %}❌ Disabled{% endif %}</li>
        </ul>
    </div>

    <div class="card">
        <h2>🔗 Available Endpoints</h2>
        <ul style="list-style: disc; padding-left: 1.5rem;">
            <!-- Pages -->
            <li><a href="/" style="color: #007bff; text-decoration: none;"><strong>GET /</strong></a> - Main landing page</li>
            <li><a href="/welcome" style="color: #007bff; text-decoration: none;"><strong>GET /welcome</strong></a> - Alias for /</li>
            <!-- Health Checks -->
            <li><a href="/health" style="color: #007bff; text-decoration: none;"><strong>GET /health</strong></a> - Liveness Probe (K8s)</li>
            <li><a href="/ready" style="color: #007bff; text-decoration: none;"><strong>GET /ready</strong></a> - Readiness Probe (K8s) with latency metrics</li>
            <li><a href="/api/health" style="color: #007bff; text-decoration: none;"><strong>GET /api/health</strong></a> - Aggregated PHP + Node health</li>
            <li><a href="/status" style="color: #007bff; text-decoration: none;"><strong>GET /status</strong></a> - Full status overview (all services)</li>
            <li><!--suppress HtmlUnknownTarget --><a href="/health.php" style="color: #007bff; text-decoration: none;"><strong>GET /health.php</strong></a> - Docker HEALTHCHECK (minimal overhead)</li>
            <!-- Node.js API -->
            {% if env.ENABLE_NODE and env.NODE_MODE in ['assets-api', 'api'] %}
            <li><a href="/api/node/hello" style="color: #007bff; text-decoration: none;"><strong>GET /api/node/hello</strong></a> - Node.js Hello endpoint (?name=)</li>
            <li>
                <strong>POST /api/node/echo</strong> - Echo request body (JSON)
                <span
                    id="copy-curl-btn"
                    title="Click to copy curl command"
                    style="cursor: pointer; margin-left: 0.4rem; padding: 0.1rem 0.4rem; font-size: 0.75rem; font-weight: bold; color: #007bff; background: #e7f1ff; border: 1px solid #007bff; border-radius: 4px; user-select: none;"
                >i</span>
                <script nonce="{{ nonce() }}">
                    document.getElementById('copy-curl-btn').addEventListener('click', function() {
                        const cmd = "curl -X POST https://localhost:8443/api/node/echo -H 'Content-Type: application/json' -d '{\"hello\": \"world\"}'";
                        const btn = this;
                        navigator.clipboard.writeText(cmd).then(function() {
                            btn.textContent = '✓';
                            btn.style.background = '#d4edda';
                            btn.style.borderColor = '#28a745';
                            btn.style.color = '#28a745';
                            setTimeout(function() {
                                btn.textContent = 'i';
                                btn.style.background = '#e7f1ff';
                                btn.style.borderColor = '#007bff';
                                btn.style.color = '#007bff';
                            }, 1500);
                        });
                    });
                </script>
            </li>
            {% endif %}
            <!-- Development -->
            <li><a href="/_dev" style="color: #007bff; text-decoration: none;"><strong>GET /_dev</strong></a> - Development Dashboard</li>
        </ul>
        <p style="margin-top: 1rem; font-size: 0.9em; color: #666;">
            <strong>Tip:</strong> Use <code>/health</code> for liveness probes, <code>/ready</code> for readiness probes (K8s),
            and <code>/status</code> for monitoring dashboards.
        </p>
    </div>

    {% if vite.isDevelopment() %}
    <div class="card">
        <h2>📖 Documentation</h2>
        {% if docsMissing %}
        <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; padding: 0.75rem 1rem; margin-bottom: 1rem;">
            <strong style="color: #856404;">⚠️ API documentation not generated.</strong>
            <span style="color: #856404;">Run <code style="background: #f8f9fa; padding: 0.2rem 0.4rem; border-radius: 3px;">make docs</code> to generate.</span>
        </div>
        {% endif %}
        <p style="margin-bottom: 1rem;">Guides and auto-generated API documentation:</p>
        <ul style="list-style: disc; padding-left: 1.5rem;">
            <li><a href="/docs/" style="color: #007bff; text-decoration: none;"><strong>/docs/</strong></a> - Guides & Documentation (Docsify)</li>
            <li><a href="/docs/api/php/" style="color: {% if phpDocsExist %}#007bff{% else %}#999{% endif %}; text-decoration: none;"><strong>/docs/api/php/</strong></a> - PHP API Documentation{% if not phpDocsExist and hasPhpSource %} <span style="color: #dc3545;">(not generated)</span>{% endif %}</li>
            <li><a href="/docs/api/node-backend/" style="color: {% if nodeBackendDocsExist %}#007bff{% else %}#999{% endif %}; text-decoration: none;"><strong>/docs/api/node-backend/</strong></a> - Node.js Backend API{% if not nodeBackendDocsExist and hasNodeBackendSource %} <span style="color: #dc3545;">(not generated)</span>{% endif %}</li>
        </ul>
        <p style="margin-top: 1rem; font-size: 0.9em; color: #666;">
            <strong>Generate API Docs:</strong> Run <code>make docs</code> to generate/update API documentation.
            Documentation is only available in development mode.
        </p>
    </div>
    {% endif %}

    <div class="card">
        <h2>📚 Quick Start</h2>

        <h3 style="margin-top: 1rem;">🚀 Initial Setup (First Time)</h3>
        <pre style="background: #f5f5f5; padding: 0.5rem; border-radius: 4px; overflow-x: auto;"># Full setup - creates directories, auto-detects user IDs, installs dependencies
make setup

# See which shipped templates still need your input
make customize

# Verify installation
make check-health</pre>

        <h3 style="margin-top: 1rem;">💻 Daily Development</h3>
        <pre style="background: #f5f5f5; padding: 0.5rem; border-radius: 4px; overflow-x: auto;"># Start services (uses existing images)
make up

# Stop services
make down

# Rebuild images (only when Dockerfile changes)
make build

# Service-specific commands (optional service names)
make restart php nginx    # Restart specific services
make logs php             # View logs of specific services
make build php            # Build specific images</pre>

        <h3 style="margin-top: 1rem;">⚙️ Service Configuration</h3>
        <pre style="background: #f5f5f5; padding: 0.5rem; border-radius: 4px; overflow-x: auto;"># Enable/disable services in .env.local (overrides .env):
ENABLE_PHP=true       # PHP-FPM
ENABLE_NODE=true      # Node.js (Vite + Backend)
ENABLE_DATABASE=true  # Database container
ENABLE_REDIS=true     # Redis Cache

# Database type (postgres or mariadb)
DB_TYPE=postgres

# Node.js mode (assets-api|assets|api|framework|framework-api|idle)
NODE_MODE=assets-api</pre>
    </div>

    {% if vite.isDevelopment() %}
    <div class="card">
        <h2>🎨 HMR Demo</h2>
        <p>Try editing <code>resources/css/test.scss</code> or <code>resources/js/app.js</code> - changes appear instantly without page reload!</p>
        <button id="test-btn" class="btn">Test Button (Click me!)</button>
    </div>
    {% endif %}
</div>

<!-- Vite JavaScript - Loaded last -->
{{ vite.renderScriptTags('js/app.js')|raw }}

</body>
</html>
