{% extends "dev-dashboard/layout.html.twig" %}

{% block title %}Health Check{% endblock %}

{% block content %}
{% set categoryLabels = {
    'core': {'icon': '🔧', 'title': 'Core Services', 'desc': 'Essential services for the application'},
    'data': {'icon': '💾', 'title': 'Data Services', 'desc': 'Databases and caching'},
    'optional': {'icon': '🔌', 'title': 'Optional Services', 'desc': 'Additional tools and integrations'}
} %}

{% set tabs = {
    'services': 'Services',
    'connections': 'Connections',
    'ssl': 'SSL'
} %}

<!-- Sub-Navigation -->
<nav class="sub-nav" style="background: white; border: 1px solid #e5e7eb; border-radius: 0.5rem; margin-bottom: 1.5rem; position: sticky; top: 120px; z-index: 50;">
    <div style="display: flex; gap: 0;">
        {% for id, label in tabs %}
            <a href="#"
               data-tab="{{ id }}"
               class="sub-nav-link {% if id == 'services' %}active{% endif %}"
               style="display: inline-block; padding: 0.75rem 1rem; border-bottom: 2px solid transparent; color: #6b7280; font-size: 0.875rem; font-weight: 500; text-decoration: none; transition: all 0.2s;"
            >{{ label }}</a>
        {% endfor %}
    </div>
</nav>

<!-- Tab: Services -->
<div id="tab-services" class="tab-panel">
    <div class="space-y-6">
        {% for category, categoryServices in services %}
            {% if categoryServices is not empty %}
                {% set label = categoryLabels[category]|default({'icon': '📦', 'title': category|capitalize, 'desc': ''}) %}

                <div class="card">
                    <div class="mb-4">
                        <h2 class="text-lg font-semibold text-gray-900">
                            {{ label.icon }} {{ label.title }}
                        </h2>
                        <p class="text-sm text-gray-500">{{ label.desc }}</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        {% for key, service in categoryServices %}
                            <div class="border border-gray-200 rounded-lg p-4 {% if service.status == 'stopped' %}bg-red-50 border-red-200{% endif %}">
                                <div class="flex items-center justify-between mb-2">
                                    <div>
                                        <h3 class="font-medium text-gray-900">{{ service.name }}</h3>
                                        <p class="text-xs text-gray-500">{{ service.description }}</p>
                                    </div>
                                    <span class="badge {% if service.status == 'running' %}badge-green{% else %}badge-red{% endif %}">
                                        {% if service.status == 'running' %}● Running{% else %}○ Stopped{% endif %}
                                    </span>
                                </div>

                                {% if service.port %}
                                    <div class="text-xs text-gray-600 mt-2">
                                        <span class="font-mono bg-gray-100 px-1.5 py-0.5 rounded">
                                            {{ key }}:{{ service.port }}
                                        </span>
                                    </div>
                                {% endif %}

                                {% if service.status == 'stopped' and service.details.error is defined %}
                                    <div class="mt-2 text-xs text-red-600">
                                        {{ service.details.error }}
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>
</div>

<!-- Tab: Connections -->
<div id="tab-connections" class="tab-panel hidden">
    <div class="card">
        <div class="mb-4">
            <h2 class="text-lg font-semibold text-gray-900">Connections</h2>
            <p class="text-sm text-gray-500">Detailed connectivity and version information</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {% for name, conn in connections %}
                <div class="border border-gray-200 rounded-lg p-4 {% if not conn.connected %}bg-red-50 border-red-200{% endif %}">
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <h3 class="font-medium text-gray-900">{{ conn.type|default(name|capitalize) }}</h3>
                        </div>
                        <span class="badge {% if conn.connected %}badge-green{% else %}badge-red{% endif %}">
                            {% if conn.connected %}✓ Connected{% else %}✗ Failed{% endif %}
                        </span>
                    </div>

                    {% if conn.connected %}
                        <dl class="space-y-1.5 text-sm">
                            {% if conn.host is defined %}
                                <div class="flex justify-between">
                                    <dt class="text-gray-500">Host:</dt>
                                    <dd class="font-mono text-gray-700">{{ conn.host }}:{{ conn.port }}</dd>
                                </div>
                            {% endif %}

                            {% if conn.database is defined %}
                                <div class="flex justify-between">
                                    <dt class="text-gray-500">Database:</dt>
                                    <dd class="font-mono text-gray-700">{{ conn.database }}</dd>
                                </div>
                            {% endif %}

                            {% if conn.version is defined %}
                                <div class="flex justify-between">
                                    <dt class="text-gray-500">Version:</dt>
                                    <dd class="text-gray-700 text-xs truncate max-w-[200px]" title="{{ conn.version }}">
                                        {{ conn.version|slice(0, 40) }}
                                    </dd>
                                </div>
                            {% endif %}

                            {% if conn.tls is defined %}
                                <div class="flex justify-between">
                                    <dt class="text-gray-500">TLS:</dt>
                                    <dd>
                                        <span class="badge {% if conn.tls %}badge-green{% else %}badge-gray{% endif %}">
                                            {% if conn.tls %}🔒 Enabled{% else %}Disabled{% endif %}
                                        </span>
                                    </dd>
                                </div>
                            {% endif %}
                        </dl>
                    {% else %}
                        <div class="text-sm text-red-600 bg-red-100 rounded p-2">
                            <p class="font-medium">Connection Failed</p>
                            <p class="text-xs mt-1">{{ conn.error|default('Unknown error') }}</p>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<!-- Tab: SSL -->
<div id="tab-ssl" class="tab-panel hidden">
    <div class="card">
        <div class="mb-4">
            <h2 class="text-lg font-semibold text-gray-900">SSL Certificates</h2>
            <p class="text-sm text-gray-500">HTTPS and internal service certificates</p>
        </div>

        {% if ssl.exists and ssl.certificates is not empty %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {% for key, cert in ssl.certificates %}
                    <div class="border border-gray-200 rounded-lg p-4 {% if not cert.valid %}bg-red-50 border-red-200{% endif %}">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="font-medium text-gray-900">{{ cert.name }}</h3>
                            <div class="flex items-center gap-2">
                                {% if not cert.valid %}
                                    <span class="badge badge-red">Invalid</span>
                                {% elseif cert.expires_soon|default(false) %}
                                    <span class="badge badge-yellow">{{ cert.days_until_expiry }}d</span>
                                {% else %}
                                    <span class="badge badge-green">Valid</span>
                                {% endif %}
                            </div>
                        </div>

                        {% if cert.message is defined %}
                            <p class="text-sm text-red-600">{{ cert.message }}</p>
                        {% else %}
                            <dl class="space-y-1 text-sm">
                                <div class="flex justify-between">
                                    <dt class="text-gray-500">Subject</dt>
                                    <dd class="font-mono text-xs text-gray-900">{{ cert.subject }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-500">Issuer</dt>
                                    <dd class="font-mono text-xs text-gray-700">{{ cert.issuer }}</dd>
                                </div>
                                <div class="flex justify-between">
                                    <dt class="text-gray-500">Expires</dt>
                                    <dd class="text-gray-900">
                                        {{ cert.valid_to }}
                                        <span class="text-gray-500">({{ cert.days_until_expiry }}d)</span>
                                    </dd>
                                </div>
                            </dl>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                <p class="text-sm text-yellow-800">
                    {{ ssl.message|default('No SSL certificates found') }}
                </p>
                <p class="text-xs text-yellow-700 mt-2">
                    Run <code class="bg-yellow-100 px-1 py-0.5 rounded">make ssl-internal</code> to generate certificates.
                </p>
            </div>
        {% endif %}
    </div>
</div>

<style>
/* noinspection CssUnusedSymbol */
.sub-nav-link.active { color: #2563eb !important; border-bottom-color: #2563eb !important; }
.sub-nav-link:hover { color: #374151; border-bottom-color: #d1d5db; }
</style>

{# Page logic lives in resources/js/dev-dashboard/health.ts (built via Vite,
   shared tab navigation only) #}
{{ vite.renderScriptTags('js/dev-dashboard/health.ts')|raw }}
{% endblock %}
