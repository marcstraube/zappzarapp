{% extends "dev-dashboard/layout.html.twig" %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Health Status Overview -->
    <div class="card col-span-full">
        <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
                {% set status = healthStatus.status|default('unknown') %}
                {% set statusColors = {
                    'healthy': 'text-green-600 bg-green-100',
                    'degraded': 'text-yellow-600 bg-yellow-100',
                    'unhealthy': 'text-red-600 bg-red-100'
                } %}
                {% set statusIcons = {
                    'healthy': '✓',
                    'degraded': '⚠',
                    'unhealthy': '✗'
                } %}
                {% set color = statusColors[status]|default('text-gray-600 bg-gray-100') %}
                {% set icon = statusIcons[status]|default('?') %}

                <div class="flex-shrink-0">
                    <span class="inline-flex items-center justify-center h-12 w-12 rounded-full {{ color }} text-2xl">
                        {{ icon }}
                    </span>
                </div>
                <div>
                    <p class="text-sm text-gray-500">System Status</p>
                    <p class="text-2xl font-bold capitalize {{ color|split(' ')|first }}">{{ status }}</p>
                </div>
                <div class="border-l border-gray-200 pl-4">
                    <p class="text-sm text-gray-500">Services</p>
                    <p class="text-lg font-bold text-gray-900">
                        {{ healthStatus.healthy_count|default(0) }}/{{ (healthStatus.healthy_count|default(0)) + (healthStatus.unhealthy_count|default(0)) }}
                    </p>
                </div>
                {% if (healthStatus.unhealthy_count|default(0)) > 0 %}
                <div class="border-l border-gray-200 pl-4">
                    <p class="text-sm text-gray-500">Issues</p>
                    <p class="text-lg font-bold text-red-600">{{ healthStatus.unhealthy_count }}</p>
                </div>
                {% endif %}
            </div>
            <a href="/_dev/health" class="btn btn-secondary">Details</a>
        </div>
    </div>

    <!-- Quick Info Cards Row -->
    <div class="card">
        <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-gray-900">System</h3>
            <a href="/_dev/system" class="text-xs text-blue-600 hover:text-blue-800">Details</a>
        </div>
        <dl class="space-y-1 text-sm">
            <div class="flex justify-between">
                <dt class="text-gray-500">PHP</dt>
                <dd class="font-mono text-gray-900">{{ systemInfo.php_version|default('Unknown') }}</dd>
            </div>
            <div class="flex justify-between">
                <dt class="text-gray-500">Server</dt>
                <dd class="text-gray-900 text-xs">{{ systemInfo.server_software|default('Unknown') }}</dd>
            </div>
        </dl>
    </div>

    <div class="card">
        <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-gray-900">Database</h3>
            <a href="/_dev/database" class="text-xs text-blue-600 hover:text-blue-800">Details</a>
        </div>
        {% if dbStats.available|default(false) %}
        <dl class="space-y-1 text-sm">
            <div class="flex justify-between">
                <dt class="text-gray-500">Type</dt>
                <dd class="font-medium text-gray-900">{{ dbStats.type|upper }}</dd>
            </div>
            <div class="flex justify-between">
                <dt class="text-gray-500">Tables</dt>
                <dd class="font-medium text-gray-900">{{ dbStats.tables|default(0) }}</dd>
            </div>
        </dl>
        {% else %}
        <p class="text-sm text-gray-500">{{ dbStats.message|default('Not connected') }}</p>
        {% endif %}
    </div>

    <div class="card">
        <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-gray-900">Git</h3>
            <a href="/_dev/system#git" class="text-xs text-blue-600 hover:text-blue-800">Details</a>
        </div>
        {% if gitStatus.initialized|default(false) %}
        <dl class="space-y-1 text-sm">
            <div class="flex justify-between">
                <dt class="text-gray-500">Branch</dt>
                <dd class="font-mono text-gray-900">{{ gitStatus.branch|default('Unknown') }}</dd>
            </div>
            <div class="flex justify-between">
                <dt class="text-gray-500">Commit</dt>
                <dd class="font-mono text-xs text-gray-700">{{ gitStatus.commit|default('-') }}</dd>
            </div>
        </dl>
        {% else %}
        <p class="text-sm text-gray-500">{{ gitStatus.message|default('Not available') }}</p>
        {% endif %}
    </div>

    <!-- Quick Actions -->
    <div class="card">
        <h3 class="font-semibold text-gray-900 mb-3">Quick Actions</h3>
        <div class="space-y-2">
            <a href="/_dev/health" class="btn btn-primary btn-block text-sm">Run Health Check</a>
            <a href="/_dev/logs" class="btn btn-secondary btn-block text-sm">View Logs</a>
            <a href="/_dev/quality" class="btn btn-secondary btn-block text-sm">Quality Tools</a>
        </div>
    </div>

    <!-- Documentation Status -->
    <div class="card col-span-1 md:col-span-2">
        <div class="flex items-center justify-between mb-3">
            <h3 class="font-semibold text-gray-900">Documentation</h3>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
            <!-- Guides -->
            <a href="/docs/" class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
                <span class="text-sm font-medium text-gray-900">Guides</span>
                <span class="badge badge-green">Available</span>
            </a>

            <!-- PHP API -->
            {% set phpStatus = apiDocsStatus.php|default({}) %}
            {% set phpHasSource = phpStatus.hasSource|default(false) %}
            {% set phpExists = phpStatus.exists|default(false) %}
            {% set phpOutdated = phpStatus.outdated|default(false) %}

            {% if phpExists %}
            <a href="/docs/api/php/" class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
            {% else %}
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg opacity-60">
            {% endif %}
                <span class="text-sm font-medium {% if phpExists %}text-gray-900{% else %}text-gray-400{% endif %}">PHP API</span>
                {% if not phpHasSource %}
                <span class="badge badge-gray">No source</span>
                {% elseif not phpExists %}
                <span class="badge badge-red">Missing</span>
                {% elseif phpOutdated %}
                <span class="badge badge-yellow">Outdated</span>
                {% else %}
                <span class="badge badge-green">Fresh</span>
                {% endif %}
            {% if phpExists %}
            </a>
            {% else %}
            </div>
            {% endif %}

            <!-- Node Backend API -->
            {% set backendStatus = apiDocsStatus.node_backend|default({}) %}
            {% set backendHasSource = backendStatus.hasSource|default(false) %}
            {% set backendExists = backendStatus.exists|default(false) %}
            {% set backendOutdated = backendStatus.outdated|default(false) %}

            {% if backendExists %}
            <a href="/docs/api/node-backend/" class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
            {% else %}
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg opacity-60">
            {% endif %}
                <span class="text-sm font-medium {% if backendExists %}text-gray-900{% else %}text-gray-400{% endif %}">Backend API</span>
                {% if not backendHasSource %}
                <span class="badge badge-gray">No source</span>
                {% elseif not backendExists %}
                <span class="badge badge-red">Missing</span>
                {% elseif backendOutdated %}
                <span class="badge badge-yellow">Outdated</span>
                {% else %}
                <span class="badge badge-green">Fresh</span>
                {% endif %}
            {% if backendExists %}
            </a>
            {% else %}
            </div>
            {% endif %}

            <!-- Node Frontend -->
            {% set frontendStatus = apiDocsStatus.node_frontend|default({}) %}
            {% set frontendHasSource = frontendStatus.hasSource|default(false) %}
            {% set frontendExists = frontendStatus.exists|default(false) %}
            {% set frontendOutdated = frontendStatus.outdated|default(false) %}

            {% if frontendExists %}
            <a href="/docs/api/node-frontend/" class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition">
            {% else %}
            <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg opacity-60">
            {% endif %}
                <span class="text-sm font-medium {% if frontendExists %}text-gray-900{% else %}text-gray-400{% endif %}">Frontend</span>
                {% if not frontendHasSource %}
                <span class="badge badge-gray">No source</span>
                {% elseif not frontendExists %}
                <span class="badge badge-red">Missing</span>
                {% elseif frontendOutdated %}
                <span class="badge badge-yellow">Outdated</span>
                {% else %}
                <span class="badge badge-green">Fresh</span>
                {% endif %}
            {% if frontendExists %}
            </a>
            {% else %}
            </div>
            {% endif %}
        </div>

        {% set phpNeedsRegen = phpHasSource and (not phpExists or phpOutdated) %}
        {% set backendNeedsRegen = backendHasSource and (not backendExists or backendOutdated) %}
        {% set frontendNeedsRegen = frontendHasSource and (not frontendExists or frontendOutdated) %}
        {% set nodeNeedsRegen = backendNeedsRegen or frontendNeedsRegen %}
        {% set multipleNeedRegen = (phpNeedsRegen ? 1 : 0) + (nodeNeedsRegen ? 1 : 0) > 1 %}

        {% if phpNeedsRegen or nodeNeedsRegen %}
        <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid #e5e7eb; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;">
            {% if phpNeedsRegen %}
            <button
                id="btn-regen-php-docs"
                data-action="regenerate-docs" data-type="php"
                class="btn btn-secondary text-xs"
            >
                Regenerate PHP
            </button>
            {% endif %}
            {% if nodeNeedsRegen %}
            <button
                id="btn-regen-node-docs"
                type="button"
                data-action="regenerate-node-docs"
                class="btn btn-secondary text-xs"
            >
                Regenerate Node
            </button>
            {% endif %}
            {% if multipleNeedRegen %}
            <button
                id="btn-regen-all-docs"
                data-action="regenerate-all-docs"
                class="btn btn-primary text-xs"
            >
                Regenerate All
            </button>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>

{# Page logic lives in resources/js/dev-dashboard/dashboard.ts (built via Vite,
   uses @zappzarapp/browser-utils for request handling) #}
{{ vite.renderScriptTags('js/dev-dashboard/dashboard.ts')|raw }}
{% endblock %}
